{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "REXSDK_DIR": "${sourceDir}/thirdparty/rexglue-sdk",
        "SDL_X11_XTEST": "OFF",
        "CMAKE_C_FLAGS": "-march=x86-64-v3",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "mac-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "REXSDK_DIR": "${sourceDir}/thirdparty/rexglue-sdk",
        "CMAKE_CXX_STANDARD": "23"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "mac-arm64-base",
      "hidden": true,
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-mcpu=apple-m3",
        "CMAKE_CXX_FLAGS": "-mcpu=apple-m3",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "mac-amd64-base",
      "hidden": true,
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-march=x86-64-v3",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "linux-amd64-debug",
      "displayName": "Linux AMD64 Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-amd64-release",
      "displayName": "Linux AMD64 Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "REXGLUE_ENABLE_TRACY": "OFF",
        "REXGLUE_ENABLE_PERF_COUNTERS": "OFF",
        "CMAKE_C_FLAGS": "-march=x86-64-v3 -flto=thin",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3 -flto=thin"
      }
    },
    {
      "name": "linux-amd64-relwithdebinfo",
      "displayName": "Linux AMD64 RelWithDebInfo",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "REXGLUE_ENABLE_TRACY": "OFF",
        "REXGLUE_ENABLE_PERF_COUNTERS": "OFF",
        "CMAKE_C_FLAGS": "-march=x86-64-v3 -flto=thin",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3 -flto=thin"
      }
    },
    {
      "name": "mac-arm64-debug",
      "displayName": "macOS ARM64 Debug",
      "inherits": "mac-arm64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mac-arm64-release",
      "displayName": "macOS ARM64 Release",
      "inherits": "mac-arm64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "REXGLUE_ENABLE_TRACY": "OFF",
        "REXGLUE_ENABLE_PERF_COUNTERS": "OFF",
        "CMAKE_C_FLAGS": "-mcpu=apple-m3 -flto=thin",
        "CMAKE_CXX_FLAGS": "-mcpu=apple-m3 -flto=thin"
      }
    },
    {
      "name": "mac-arm64-relwithdebinfo",
      "displayName": "macOS ARM64 RelWithDebInfo",
      "inherits": "mac-arm64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "REXGLUE_ENABLE_TRACY": "OFF",
        "REXGLUE_ENABLE_PERF_COUNTERS": "OFF",
        "CMAKE_C_FLAGS": "-mcpu=apple-m3 -flto=thin",
        "CMAKE_CXX_FLAGS": "-mcpu=apple-m3 -flto=thin"
      }
    },
    {
      "name": "mac-amd64-debug",
      "displayName": "macOS AMD64 Debug",
      "inherits": "mac-amd64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mac-amd64-release",
      "displayName": "macOS AMD64 Release",
      "inherits": "mac-amd64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "REXGLUE_ENABLE_TRACY": "OFF",
        "REXGLUE_ENABLE_PERF_COUNTERS": "OFF",
        "CMAKE_C_FLAGS": "-march=x86-64-v3 -flto=thin",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3 -flto=thin"
      }
    },
    {
      "name": "mac-amd64-relwithdebinfo",
      "displayName": "macOS AMD64 RelWithDebInfo",
      "inherits": "mac-amd64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "REXGLUE_ENABLE_TRACY": "OFF",
        "REXGLUE_ENABLE_PERF_COUNTERS": "OFF",
        "CMAKE_C_FLAGS": "-march=x86-64-v3 -flto=thin",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3 -flto=thin"
      }
    },
    {
      "name": "web-wasm64-release",
      "displayName": "Web (WebAssembly, Memory64) Release",
      "description": "Browser build (docs/web-port/README.md 10.1). Run in a shell with emsdk active, after a native build (it compiles generated/default).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TRIALSHD_WEB": "ON"
      }
    },
    {
      "name": "web-wasm32-release",
      "displayName": "Web (WebAssembly, 32-bit memory) Release",
      "description": "As web-wasm64-release with a 4 GiB wasm32 memory, whose accesses browsers check with guard pages instead of explicit bounds checks (docs/web-port/README.md W-L13).",
      "inherits": "web-wasm64-release",
      "cacheVariables": {
        "TRIALSHD_WEB_WASM32": "ON"
      }
    },
    {
      "name": "web-wasm64-node",
      "displayName": "Web build for Node.js (development)",
      "description": "The web build run by Node with direct access to the host file system, for headless boot checks (docs/web-port/README.md 11).",
      "inherits": "web-wasm64-release",
      "cacheVariables": {
        "TRIALSHD_WEB_NODE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-amd64-debug",
      "configurePreset": "linux-amd64-debug"
    },
    {
      "name": "linux-amd64-release",
      "configurePreset": "linux-amd64-release"
    },
    {
      "name": "linux-amd64-relwithdebinfo",
      "configurePreset": "linux-amd64-relwithdebinfo"
    },
    {
      "name": "mac-arm64-debug",
      "configurePreset": "mac-arm64-debug"
    },
    {
      "name": "mac-arm64-release",
      "configurePreset": "mac-arm64-release"
    },
    {
      "name": "mac-arm64-relwithdebinfo",
      "configurePreset": "mac-arm64-relwithdebinfo"
    },
    {
      "name": "mac-amd64-debug",
      "configurePreset": "mac-amd64-debug"
    },
    {
      "name": "mac-amd64-release",
      "configurePreset": "mac-amd64-release"
    },
    {
      "name": "mac-amd64-relwithdebinfo",
      "configurePreset": "mac-amd64-relwithdebinfo"
    },
    {
      "name": "web-wasm64-release",
      "configurePreset": "web-wasm64-release"
    },
    {
      "name": "web-wasm32-release",
      "configurePreset": "web-wasm32-release"
    },
    {
      "name": "web-wasm64-node",
      "configurePreset": "web-wasm64-node"
    }
  ]
}
