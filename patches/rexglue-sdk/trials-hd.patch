+      begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      succeeded = dfn.vkBeginCommandBuffer(submission.command_buffer, &begin_info) == VK_SUCCESS;
+    }
