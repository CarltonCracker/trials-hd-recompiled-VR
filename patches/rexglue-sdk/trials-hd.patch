+
 X_RESULT MnkInputDriver::GetDeviceKeystroke(DeviceId id, uint32_t flags,
                                             X_INPUT_KEYSTROKE* out_keystroke) {
   if (!IsEnabled() || id != kMnkDevice) {
     return X_ERROR_DEVICE_NOT_CONNECTED;
   }
   std::lock_guard lock(state_mutex_);
+  if (keystroke_queue_.empty()) {
+    // Synthesize keystrokes from button transitions, as the SDL pad driver
+    // does; XUI menus read input only through XamInputGetKeystroke. Inactive
+    // or unfocused reads as all-released, so held keys send their UP events.
+    uint32_t pressed = (is_active() && has_focus_) ? PressedButtonsLocked() : 0;
+    uint32_t changed = pressed ^ keystroke_buttons_;
+    for (const auto& [bit, vk] : kKeystrokeMap) {
+      if (changed & bit) {
+        EnqueueKeystroke(uint16_t(vk), (pressed & bit) != 0);
+      }
+    }
+    keystroke_buttons_ = pressed;
+  }
   if (keystroke_queue_.empty()) {
     return X_ERROR_EMPTY;
   }
