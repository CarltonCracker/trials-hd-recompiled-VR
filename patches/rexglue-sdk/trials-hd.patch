diff --git a/src/input/web/web_input_driver.cpp b/src/input/web/web_input_driver.cpp
new file mode 100644
index 0000000..cc3bd3e
--- /dev/null
+++ b/src/input/web/web_input_driver.cpp
@@ -0,0 +1,312 @@
+/**
+ * @file        input/web/web_input_driver.cpp
+ * @brief       Gamepads in the web (Emscripten) build
+ */
+
+#include <rex/input/web/web_input_driver.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <tuple>
+
+#include <rex/chrono/clock.h>
+#include <rex/input/flags.h>
+
+namespace rex::input::web {
+
+namespace {
+
+// As the SDL driver (sdl_input_driver.h).
+constexpr int16_t kThumbThreshold = 0x4E00;
+constexpr uint8_t kTriggerThreshold = 0x1F;
+constexpr uint64_t kRepeatDelayMs = 400;
+constexpr uint64_t kRepeatRateMs = 100;
+
+constexpr uint64_t kDeviceIdBase = 0x5745425000ull;  // "WEBP" + pad index
+
+GamepadSource& Source() {
+  static GamepadSource source;
+  return source;
+}
+
+DeviceId PadDeviceId(uint32_t index) {
+  return static_cast<DeviceId>(kDeviceIdBase + index);
+}
+
+int16_t AxisToThumb(float value, bool invert) {
+  if (!std::isfinite(value)) return 0;
+  float v = std::clamp(invert ? -value : value, -1.0f, 1.0f);
+  return static_cast<int16_t>(std::lround(v * (v < 0.0f ? 32768.0f : 32767.0f)));
+}
+
+uint8_t ValueToTrigger(float value) {
+  if (!std::isfinite(value)) return 0;
+  return static_cast<uint8_t>(std::lround(std::clamp(value, 0.0f, 1.0f) * 255.0f));
+}
+
+// Standard mapping (W3C Gamepad API) button index -> XInput button.
+constexpr std::array<uint16_t, 17> kStandardToXInput = {
+    X_INPUT_GAMEPAD_A,              X_INPUT_GAMEPAD_B,
+    X_INPUT_GAMEPAD_X,              X_INPUT_GAMEPAD_Y,
+    X_INPUT_GAMEPAD_LEFT_SHOULDER,  X_INPUT_GAMEPAD_RIGHT_SHOULDER,
+    0,                              0,  // triggers are analog
+    X_INPUT_GAMEPAD_BACK,           X_INPUT_GAMEPAD_START,
+    X_INPUT_GAMEPAD_LEFT_THUMB,     X_INPUT_GAMEPAD_RIGHT_THUMB,
+    X_INPUT_GAMEPAD_DPAD_UP,        X_INPUT_GAMEPAD_DPAD_DOWN,
+    X_INPUT_GAMEPAD_DPAD_LEFT,      X_INPUT_GAMEPAD_DPAD_RIGHT,
+    X_INPUT_GAMEPAD_GUIDE,
+};
+
+// Analog inputs as extra "buttons" for keystrokes (bits 16.. as the SDL driver).
+uint64_t AnalogToKeyfield(const X_INPUT_GAMEPAD& gamepad) {
+  uint64_t f = 0;
+  f |= uint64_t(gamepad.left_trigger > kTriggerThreshold) << 16;
+  f |= uint64_t(gamepad.right_trigger > kTriggerThreshold) << 17;
+  int16_t thumb_x = static_cast<int16_t>(gamepad.thumb_lx);
+  int16_t thumb_y = static_cast<int16_t>(gamepad.thumb_ly);
+  for (size_t i = 0; i <= 8; i += 8) {
+    uint64_t u = thumb_y > kThumbThreshold;
+    uint64_t d = thumb_y < ~kThumbThreshold;
+    uint64_t r = thumb_x > kThumbThreshold;
+    uint64_t l = thumb_x < ~kThumbThreshold;
+    if (u && l) {
+      u = l = 0;
+      f |= uint64_t(1) << (22 + i);
+    }
+    if (u && r) {
+      u = r = 0;
+      f |= uint64_t(1) << (23 + i);
+    }
+    if (d && r) {
+      d = r = 0;
+      f |= uint64_t(1) << (24 + i);
+    }
+    if (d && l) {
+      d = l = 0;
+      f |= uint64_t(1) << (25 + i);
+    }
+    f |= u << (18 + i);
+    f |= d << (19 + i);
+    f |= r << (20 + i);
+    f |= l << (21 + i);
+    thumb_x = static_cast<int16_t>(gamepad.thumb_rx);
+    thumb_y = static_cast<int16_t>(gamepad.thumb_ry);
+  }
+  return f;
+}
+
+}  // namespace
+
+void SetGamepadSource(GamepadSource source) {
+  Source() = std::move(source);
+}
+
+const GamepadSource& GetGamepadSource() {
+  return Source();
+}
+
+WebInputDriver::WebInputDriver(rex::ui::Window* window, size_t window_z_order,
+                               GamepadSource source)
+    : InputDriver(window, window_z_order), source_(std::move(source)) {}
+
+WebInputDriver::~WebInputDriver() = default;
+
+X_STATUS WebInputDriver::Setup() {
+  return source_ ? X_STATUS_SUCCESS : X_STATUS_UNSUCCESSFUL;
+}
+
+void WebInputDriver::PollLocked() {
+  for (uint32_t i = 0; i < kMaxPads; ++i) {
+    WebGamepad gamepad;
+    if (!source_(i, gamepad)) {
+      continue;  // Being written: keep the previous state.
+    }
+    Pad& pad = pads_[i];
+    pad.connected = gamepad.connected;
+    if (!gamepad.connected) {
+      pad = {};
+      continue;
+    }
+    uint16_t buttons = 0;
+    for (size_t b = 0; b < kStandardToXInput.size(); ++b) {
+      if (gamepad.buttons & (1u << b)) {
+        buttons |= kStandardToXInput[b];
+      }
+    }
+    if (!REXCVAR_GET(guide_button)) {
+      buttons &= ~uint16_t(X_INPUT_GAMEPAD_GUIDE);
+    }
+    X_INPUT_GAMEPAD next = {};
+    next.buttons = buttons;
+    next.left_trigger = ValueToTrigger(gamepad.triggers[0]);
+    next.right_trigger = ValueToTrigger(gamepad.triggers[1]);
+    next.thumb_lx = AxisToThumb(gamepad.axes[0], false);
+    next.thumb_ly = AxisToThumb(gamepad.axes[1], true);  // XInput: +y = up.
+    next.thumb_rx = AxisToThumb(gamepad.axes[2], false);
+    next.thumb_ry = AxisToThumb(gamepad.axes[3], true);
+    if (std::memcmp(&next, &pad.state.gamepad, sizeof(next)) != 0) {
+      pad.state.gamepad = next;
+      pad.state_changed = true;
+    }
+  }
+}
+
+WebInputDriver::Pad* WebInputDriver::FindPadLocked(DeviceId id) {
+  uint64_t value = static_cast<uint64_t>(id);
+  if (value < kDeviceIdBase || value >= kDeviceIdBase + kMaxPads) {
+    return nullptr;
+  }
+  Pad& pad = pads_[value - kDeviceIdBase];
+  return pad.connected ? &pad : nullptr;
+}
+
+void WebInputDriver::EnumerateDevices(std::vector<DeviceInfo>& out) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  PollLocked();
+  for (uint32_t i = 0; i < kMaxPads; ++i) {
+    if (pads_[i].connected) {
+      DeviceInfo info;
+      info.id = PadDeviceId(i);
+      info.name = "Gamepad (browser)";
+      out.push_back(info);
+    }
+  }
+}
+
+X_RESULT WebInputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
+  bool is_active = this->is_active();
+  std::lock_guard<std::mutex> lock(mutex_);
+  PollLocked();
+  Pad* pad = FindPadLocked(id);
+  if (!pad) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  // As the SDL driver: one packet per change, and an idle pad while inactive.
+  if (is_active != pad->is_active || (is_active && pad->state_changed)) {
+    pad->state.packet_number = pad->state.packet_number + 1;
+    pad->is_active = is_active;
+    pad->state_changed = false;
+  }
+  std::memcpy(out_state, &pad->state, sizeof(*out_state));
+  if (!is_active) {
+    std::memset(&out_state->gamepad, 0, sizeof(out_state->gamepad));
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT WebInputDriver::GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                               X_INPUT_CAPABILITIES* out_caps) {
+  (void)flags;
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!FindPadLocked(id)) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  std::memset(out_caps, 0, sizeof(*out_caps));
+  out_caps->type = XINPUT_DEVTYPE_GAMEPAD;
+  out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+  out_caps->gamepad.buttons = 0xF3FF | (REXCVAR_GET(guide_button) ? X_INPUT_GAMEPAD_GUIDE : 0x0);
+  out_caps->gamepad.left_trigger = 0xFF;
+  out_caps->gamepad.right_trigger = 0xFF;
+  out_caps->gamepad.thumb_lx = static_cast<int16_t>(0xFFFFu);
+  out_caps->gamepad.thumb_ly = static_cast<int16_t>(0xFFFFu);
+  out_caps->gamepad.thumb_rx = static_cast<int16_t>(0xFFFFu);
+  out_caps->gamepad.thumb_ry = static_cast<int16_t>(0xFFFFu);
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT WebInputDriver::SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) {
+  (void)vibration;  // The Gamepad API's haptics are not wired up (yet).
+  std::lock_guard<std::mutex> lock(mutex_);
+  return FindPadLocked(id) ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+}
+
+X_RESULT WebInputDriver::GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                                            X_INPUT_KEYSTROKE* out_keystroke) {
+  (void)flags;
+  if (!out_keystroke) {
+    return X_ERROR_BAD_ARGUMENTS;
+  }
+  // The SDL driver's order and algorithm (sdl_input_driver.cpp).
+  static constexpr std::array<rex::ui::VirtualKey, 34> kVkLookup = {
+      rex::ui::VirtualKey::kXInputPadDpadUp,      rex::ui::VirtualKey::kXInputPadDpadDown,
+      rex::ui::VirtualKey::kXInputPadDpadLeft,    rex::ui::VirtualKey::kXInputPadDpadRight,
+      rex::ui::VirtualKey::kXInputPadStart,       rex::ui::VirtualKey::kXInputPadBack,
+      rex::ui::VirtualKey::kXInputPadLThumbPress, rex::ui::VirtualKey::kXInputPadRThumbPress,
+      rex::ui::VirtualKey::kXInputPadLShoulder,   rex::ui::VirtualKey::kXInputPadRShoulder,
+      rex::ui::VirtualKey::kNone,                 rex::ui::VirtualKey::kNone,
+      rex::ui::VirtualKey::kXInputPadA,           rex::ui::VirtualKey::kXInputPadB,
+      rex::ui::VirtualKey::kXInputPadX,           rex::ui::VirtualKey::kXInputPadY,
+      rex::ui::VirtualKey::kXInputPadLTrigger,    rex::ui::VirtualKey::kXInputPadRTrigger,
+      rex::ui::VirtualKey::kXInputPadLThumbUp,    rex::ui::VirtualKey::kXInputPadLThumbDown,
+      rex::ui::VirtualKey::kXInputPadLThumbRight, rex::ui::VirtualKey::kXInputPadLThumbLeft,
+      rex::ui::VirtualKey::kXInputPadLThumbUpLeft, rex::ui::VirtualKey::kXInputPadLThumbUpRight,
+      rex::ui::VirtualKey::kXInputPadLThumbDownRight, rex::ui::VirtualKey::kXInputPadLThumbDownLeft,
+      rex::ui::VirtualKey::kXInputPadRThumbUp,    rex::ui::VirtualKey::kXInputPadRThumbDown,
+      rex::ui::VirtualKey::kXInputPadRThumbRight, rex::ui::VirtualKey::kXInputPadRThumbLeft,
+      rex::ui::VirtualKey::kXInputPadRThumbUpLeft, rex::ui::VirtualKey::kXInputPadRThumbUpRight,
+      rex::ui::VirtualKey::kXInputPadRThumbDownRight, rex::ui::VirtualKey::kXInputPadRThumbDownLeft,
+  };
+
+  bool is_active = this->is_active();
+  std::lock_guard<std::mutex> lock(mutex_);
+  PollLocked();
+  Pad* pad = FindPadLocked(id);
+  if (!pad) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  const uint64_t current =
+      is_active ? (uint64_t(uint16_t(pad->state.gamepad.buttons)) |
+                   AnalogToKeyfield(pad->state.gamepad))
+                : uint64_t(0);
+
+  uint64_t now = rex::chrono::Clock::QueryGuestUptimeMillis();
+  if (pad->repeat_state == RepeatState::kWaiting && pad->repeat_time + kRepeatDelayMs < now) {
+    pad->repeat_state = RepeatState::kRepeating;
+  }
+  if (pad->repeat_state == RepeatState::kRepeating && pad->repeat_time + kRepeatRateMs < now) {
+    pad->repeat_time = now;
+    out_keystroke->virtual_key = uint16_t(kVkLookup.at(pad->repeat_button_index));
+    out_keystroke->unicode = 0;
+    out_keystroke->user_index = 0;
+    out_keystroke->hid_code = 0;
+    out_keystroke->flags = X_INPUT_KEYSTROKE_KEYDOWN | X_INPUT_KEYSTROKE_REPEAT;
+    return X_ERROR_SUCCESS;
+  }
+
+  uint64_t changed = current ^ pad->keystroke_buttons;
+  if (!changed) {
+    return X_ERROR_EMPTY;
+  }
+  // Ups first, so a diagonal is released before its neighbor is pressed.
+  for (auto [clear_pass, pass] = std::tuple{true, 0}; pass < 2; clear_pass = false, pass++) {
+    for (uint8_t i = 0; i < uint8_t(kVkLookup.size()); i++) {
+      uint64_t bit = uint64_t(1) << i;
+      if (!(changed & bit) || kVkLookup[i] == rex::ui::VirtualKey::kNone) {
+        continue;
+      }
+      out_keystroke->virtual_key = uint16_t(kVkLookup[i]);
+      out_keystroke->unicode = 0;
+      out_keystroke->user_index = 0;
+      out_keystroke->hid_code = 0;
+      bool pressed = current & bit;
+      if (clear_pass && !pressed) {
+        out_keystroke->flags = X_INPUT_KEYSTROKE_KEYUP;
+        pad->keystroke_buttons &= ~bit;
+        pad->repeat_state = RepeatState::kIdle;
+        return X_ERROR_SUCCESS;
+      }
+      if (!clear_pass && pressed) {
+        out_keystroke->flags = X_INPUT_KEYSTROKE_KEYDOWN;
+        pad->keystroke_buttons |= bit;
+        pad->repeat_state = RepeatState::kWaiting;
+        pad->repeat_button_index = i;
+        pad->repeat_time = now;
+        return X_ERROR_SUCCESS;
+      }
+    }
+  }
+  return X_ERROR_EMPTY;
+}
+
+}  // namespace rex::input::web
