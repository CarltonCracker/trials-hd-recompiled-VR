diff --git a/include/rex/platform/fpscr.h b/include/rex/platform/fpscr.h
index c2c4fd4..8baabfd 100644
--- a/include/rex/platform/fpscr.h
+++ b/include/rex/platform/fpscr.h
@@ -16,6 +16,11 @@
 #include <rex/types.h>
 
 #include <simde/x86/sse.h>
+#if defined(__wasm__)
+#include <cstdint>
+#include <cstdio>
+#include <simde/x86/sse2.h>
+#endif
 
 // SSE3 constants are missing from simde
 #ifndef _MM_DENORMALS_ZERO_MASK
@@ -82,6 +87,61 @@ struct FPSCRPlatform {
   }
 };
 
+#elif defined(__wasm__)
+// WebAssembly has no floating-point control register: arithmetic always rounds
+// to nearest-even and never flushes denormals. A per-thread shadow keeps the
+// guest's mode bits (x86 MXCSR encoding: rounding in bits 0-1, flush in bit 2)
+// so FPSCR reads round-trip. fctid (simde_mm_cvtsd_si64) applies that mode
+// explicitly (see the codegen PCH template). Native rides use nearest-even
+// and toward-zero (docs/web-port/README.md 14 Q6).
+// shortcut: other FP arithmetic stays nearest-even; emulate it if physics replays diverge.
+struct FPSCRPlatform {
+  static constexpr size_t RoundShift = 0;
+  static constexpr size_t RoundMaskVal = 3;
+  static constexpr size_t FlushMask = 1 << 2;
+  static constexpr u32 ExceptionMask = 0;
+  // Guest: nearest, toward zero, +infinity, -infinity -> x86 RC encoding.
+  static constexpr size_t GuestToHost[] = {0, 3, 2, 1};
+
+  static inline thread_local u32 shadow_csr = 0;
+  static inline u32 getcsr() noexcept { return shadow_csr; }
+  static inline void setcsr(u32 csr) noexcept {
+    shadow_csr = csr;
+#if !defined(NDEBUG)
+    static thread_local u32 reported_modes = 0;
+    u32 mode = csr & RoundMaskVal;
+    if (mode && !(reported_modes & (1u << mode))) {
+      reported_modes |= 1u << mode;
+      std::fprintf(stderr, "wasm FPSCR: requested rounding mode %u (shadow; explicit fctid rounding)\n", mode);
+    }
+#endif
+  }
+  static inline void InitHostExceptions(u32&) noexcept {}
+
+  // cvtsd2si with the shadow rounding mode; out-of-range and NaN give
+  // INT64_MIN like the x86 instruction.
+  static inline int64_t CvtsdSi64(simde__m128d value) noexcept {
+    double d = simde_mm_cvtsd_f64(value);
+    switch (shadow_csr & RoundMaskVal) {
+      case 1:
+        d = std::floor(d);
+        break;
+      case 2:
+        d = std::ceil(d);
+        break;
+      case 3:
+        d = std::trunc(d);
+        break;
+      default:
+        d = std::nearbyint(d);
+        break;
+    }
+    if (!(d >= -9223372036854775808.0 && d < 9223372036854775808.0)) {
+      return INT64_MIN;
+    }
+    return int64_t(d);
+  }
+};
 #else
 #error "Missing implementation for FPSCR."
 #endif
