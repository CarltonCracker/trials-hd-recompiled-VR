+bool VulkanGpuProfiler::Begin(const ui::vulkan::VulkanDevice& device,
+                              VkCommandBuffer command_buffer, bool enabled,
+                              uint64_t completed_submission, uint64_t frame) {
+  if (!initialized_) {
+    if (!enabled || failed_) {
+      return false;
+    }
+    if (!Initialize(device)) {
+      failed_ = true;
+      return false;
+    }
+  }
+  Retire(device, completed_submission, enabled);
+  if (!enabled || failed_) {
+    // Off: drop what is still in flight as it completes, then free everything.
+    ReleasePendingSlot();
+    if (!AnySlotInFlight()) {
+      DestroyPools(device);
+    }
+    window_open_ = false;
+    return false;
+  }
+  uint64_t now_ns = SteadyNowNs();
+  if (!window_open_) {
+    // Just turned on: don't mix in anything from before.
+    ResetWindow();
+    window_open_ = true;
+    window_start_ns_ = now_ns;
+    window_start_frame_ = frame;
+  } else if (now_ns - window_start_ns_ >= uint64_t(2'000'000'000)) {
+    Report(now_ns, frame);
+  }
+  uint32_t slot = AcquireSlot();
+  if (slot == kNoSlot) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = device.functions();
+  if (pools_[slot] == VK_NULL_HANDLE) {
+    VkQueryPoolCreateInfo pool_create_info = {};
+    pool_create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    pool_create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    pool_create_info.queryCount = kMaxQueriesPerSlot;
+    if (dfn.vkCreateQueryPool(device.device(), &pool_create_info, nullptr, &pools_[slot]) !=
+        VK_SUCCESS) {
+      pools_[slot] = VK_NULL_HANDLE;
+      ReleasePendingSlot();
+      ++window_.skipped;
+      return false;
+    }
+    tags_[slot].resize(kMaxQueriesPerSlot);
+  }
+  // The slot is free, so the submission that last used its queries has completed.
+  dfn.vkCmdResetQueryPool(command_buffer, pools_[slot], 0, kMaxQueriesPerSlot);
+  BeginRecording(slot, tags_[slot].data());
+  Stamp(command_buffer, Mark(kCategoryOther));
+  return true;
+}
+
+bool VulkanGpuProfiler::Initialize(const ui::vulkan::VulkanDevice& device) {
+  const ui::vulkan::VulkanInstance::Functions& ifn = device.vulkan_instance()->functions();
+  uint32_t queue_family = device.queue_family_graphics_compute();
+  uint32_t queue_family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(device.physical_device(), &queue_family_count,
+                                               nullptr);
+  std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(device.physical_device(), &queue_family_count,
+                                               queue_families.data());
+  VkPhysicalDeviceProperties properties;
+  ifn.vkGetPhysicalDeviceProperties(device.physical_device(), &properties);
+  if (queue_family >= queue_family_count || !queue_families[queue_family].timestampValidBits ||
+      !(properties.limits.timestampPeriod > 0.0f)) {
+    REXGPU_WARN("vulkan_gpu_profile: the graphics queue doesn't support timestamps");
+    return false;
+  }
+  SetTimestampFormat(properties.limits.timestampPeriod,
+                     queue_families[queue_family].timestampValidBits);
+  cmd_write_timestamp_ = device.functions().vkCmdWriteTimestamp;
+  results_.resize(kMaxQueriesPerSlot);
+  initialized_ = true;
+  REXGPU_INFO("vulkan_gpu_profile: on, {} ns per tick, {} valid timestamp bits",
+              properties.limits.timestampPeriod, queue_families[queue_family].timestampValidBits);
+  return true;
+}
+
+void VulkanGpuProfiler::Retire(const ui::vulkan::VulkanDevice& device,
+                               uint64_t completed_submission, bool harvest) {
+  const ui::vulkan::VulkanDevice::Functions& dfn = device.functions();
+  RetireCompleted(completed_submission, [&](uint32_t slot) {
+    uint32_t query_count = slot_query_count_[slot];
+    if (!harvest || failed_ || query_count < 2) {
+      return;
+    }
+    // The submission's fence has signaled, so the results are available; never wait.
+    VkResult result = dfn.vkGetQueryPoolResults(
+        device.device(), pools_[slot], 0, query_count, sizeof(uint64_t) * query_count,
+        results_.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+    if (result == VK_SUCCESS) {
+      Accumulate(slot, tags_[slot].data(), results_.data());
+      return;
+    }
+    Drop();
+    if (result == VK_ERROR_DEVICE_LOST) {
+      REXGPU_ERROR("vulkan_gpu_profile: device lost, profiling stopped");
+      failed_ = true;
+    }
+  });
+}
