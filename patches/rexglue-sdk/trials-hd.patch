+                                           regions_temp);
+      deferred_command_buffer_.ExecuteStream(submission.command_buffer, submission.stream);
+      succeeded = dfn.vkEndCommandBuffer(submission.command_buffer) == VK_SUCCESS;
+    }
+    if (succeeded) {
+      VkSubmitInfo submit_info = {};
+      submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+      submit_info.waitSemaphoreCount = uint32_t(submission.wait_semaphores.size());
+      submit_info.pWaitSemaphores =
+          submission.wait_semaphores.empty() ? nullptr : submission.wait_semaphores.data();
+      submit_info.pWaitDstStageMask =
+          submission.wait_stage_masks.empty() ? nullptr : submission.wait_stage_masks.data();
+      submit_info.commandBufferCount = 1;
+      submit_info.pCommandBuffers = &submission.command_buffer;
+      VkResult submit_result;
+      {
+        ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+            vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+        submit_result =
+            dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, submission.fence);
+      }
+      if (submit_result != VK_SUCCESS) {
+        REXGPU_ERROR("Failed to submit a Vulkan command buffer (submission thread)");
+        succeeded = false;
+        if (submit_result == VK_ERROR_DEVICE_LOST && graphics_system_) {
+          graphics_system_->OnHostGpuLossFromAnyThread(true);
+        }
+      }
+    } else {
+      REXGPU_ERROR("Failed to record a Vulkan command buffer (submission thread)");
+    }
+    if (!succeeded) {
+      // The fence will never be signaled - treat as a lost device.
+      async_submit_failed_.store(true, std::memory_order_release);
+    }
+    {
+      std::lock_guard<std::mutex> lock(async_submit_mutex_);
+      submission.stream.clear();
+      async_submit_free_streams_.push_back(std::move(submission.stream));
+      submission.hoisted_copies.clear();
+      async_submit_free_copies_.push_back(std::move(submission.hoisted_copies));
+      ++async_submit_done_;
+    }
+    async_submit_done_cv_.notify_all();
+  }
+}
