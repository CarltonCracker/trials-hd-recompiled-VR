+    if (!(overwritten & (uint32_t(1) << i))) {
+      continue;
+    }
+    RenderTargetKey key = rt_keys[i];
+    std::vector<Transfer>& transfers = last_update_transfers_[i];
+    // Whole tile rows covered (only if the rectangle spans the whole pitch).
+    uint32_t msaa_samples_x_log2 = uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X);
+    uint32_t msaa_samples_y_log2 = uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X);
+    int64_t pitch_pixels = int64_t(key.pitch_tiles_at_32bpp) *
+                           (xenos::kEdramTileWidthSamples >> msaa_samples_x_log2);
+    int64_t tile_height_pixels = xenos::kEdramTileHeightSamples >> msaa_samples_y_log2;
+    uint32_t pitch_tiles = key.GetPitchTiles();
+    uint32_t covered_start_tiles = 0, covered_end_tiles = 0;
+    if (covered_x0 <= 0 && covered_x1 >= pitch_pixels) {
+      int64_t row_start = (std::max(covered_y0, int64_t(0)) + tile_height_pixels - 1) /
+                          tile_height_pixels;
+      int64_t row_end = covered_y1 / tile_height_pixels;
+      if (row_end > row_start) {
+        covered_start_tiles = uint32_t(row_start) * pitch_tiles;
+        covered_end_tiles = uint32_t(row_end) * pitch_tiles;
+      }
+    }
+    std::vector<Transfer> kept;
+    kept.reserve(transfers.size());
+    for (const Transfer& transfer : transfers) {
+      // Fully inside the rectangle - drop.
+      Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithoutCutout];
+      uint32_t rectangle_count = transfer.GetRectangles(
+          key.base_tiles, key.pitch_tiles_at_32bpp, key.msaa_samples, key.Is64bpp(), rectangles);
+      bool inside = true;
+      for (uint32_t j = 0; j < rectangle_count; ++j) {
+        const Transfer::Rectangle& r = rectangles[j];
+        if (int64_t(r.x_pixels) < covered_x0 || int64_t(r.y_pixels) < covered_y0 ||
+            int64_t(r.x_pixels) + r.width_pixels > covered_x1 ||
+            int64_t(r.y_pixels) + r.height_pixels > covered_y1) {
+          inside = false;
+          break;
+        }
+      }
+      if (inside) {
+        continue;
+      }
+      // Otherwise keep only the tiles outside the covered rows.
+      if (covered_end_tiles > covered_start_tiles) {
+        uint32_t relative_start =
+            (transfer.start_tiles - key.base_tiles) & (xenos::kEdramTileCount - 1);
+        uint32_t relative_end = relative_start + (transfer.end_tiles - transfer.start_tiles);
+        if (relative_start < covered_end_tiles && relative_end > covered_start_tiles) {
