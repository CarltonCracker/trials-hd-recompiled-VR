+bool DrawExtentEstimator::EstimateRectangleListBounds(const Shader& vertex_shader,
+                                                      float& x0_out, float& y0_out,
+                                                      float& x1_out, float& y1_out) {
+  const RegisterFile& regs = register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (vgt_draw_initiator.prim_type != xenos::PrimitiveType::kRectangleList ||
+      vgt_draw_initiator.num_indices != 3 ||
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex ||
+      xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type)) {
+    return false;
+  }
+  assert_true(vertex_shader.type() == xenos::ShaderType::kVertex);
+  if (!vertex_shader.is_ucode_analyzed() ||
+      !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return false;
+  }
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float viewport_x_scale =
+      pa_cl_vte_cntl.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  float viewport_x_offset =
+      pa_cl_vte_cntl.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  float viewport_y_scale =
+      pa_cl_vte_cntl.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  float viewport_y_offset =
+      pa_cl_vte_cntl.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+  // Same conventions as EstimateVertexMaxY: D3D pixel centers at integers.
+  float pixel_offset =
+      regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero ? 0.5f : 0.0f;
+  float window_x_offset = 0.0f, window_y_offset = 0.0f;
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+    auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    window_x_offset = float(pa_sc_window_offset.window_x_offset);
+    window_y_offset = float(pa_sc_window_offset.window_y_offset);
+  }
+
+  float x0 = FLT_MAX, y0 = FLT_MAX, x1 = -FLT_MAX, y1 = -FLT_MAX;
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionExportSink export_sink;
+  shader_interpreter_.SetExportSink(&export_sink);
+  bool valid = true;
+  for (uint32_t i = 0; i < 3 && valid; ++i) {
+    uint32_t vertex_index = std::min(max_index, std::max(min_index, (i + index_offset) & 0xFFFFFF));
+    export_sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if ((export_sink.vertex_kill().has_value() &&
+         (export_sink.vertex_kill().value() & ~(UINT32_C(1) << 31))) ||
+        !export_sink.position_x().has_value() || !export_sink.position_y().has_value()) {
+      valid = false;
+      break;
+    }
+    float x = export_sink.position_x().value();
+    float y = export_sink.position_y().value();
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      if (!export_sink.position_w().has_value() || !(export_sink.position_w().value() > 0.0f)) {
+        valid = false;
+        break;
+      }
+      x /= export_sink.position_w().value();
+      y /= export_sink.position_w().value();
+    }
+    x = x * viewport_x_scale + viewport_x_offset + pixel_offset + window_x_offset;
+    y = y * viewport_y_scale + viewport_y_offset + pixel_offset + window_y_offset;
+    if (!std::isfinite(x) || !std::isfinite(y)) {
+      valid = false;
+      break;
+    }
+    x0 = std::min(x0, x);
+    y0 = std::min(y0, y);
+    x1 = std::max(x1, x);
+    y1 = std::max(y1, y);
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (!valid) {
+    return false;
+  }
+  x0_out = x0;
+  y0_out = y0;
+  x1_out = x1;
+  y1_out = y1;
+  return true;
+}
