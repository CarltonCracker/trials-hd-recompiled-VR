diff --git a/include/rex/memory/web_guest.h b/include/rex/memory/web_guest.h
new file mode 100644
index 0000000..a93c150
--- /dev/null
+++ b/include/rex/memory/web_guest.h
@@ -0,0 +1,133 @@
+/**
+ * @file        memory/web_guest.h
+ * @brief       Guest memory access for the web (Emscripten) build
+ *
+ * WebAssembly has one linear memory without page aliasing or protection.
+ * Guest address aliases (the physical views, 0x7F000000 and 0x90000000) are
+ * folded onto one 2.75 GiB window by a table indexed by the top 8 address
+ * bits, and every write to guest physical memory marks its 4 KiB page in a
+ * dirty bitmap that the GPU front-end consumes before it reads guest memory.
+ * See docs/web-port/README.md (Trials HD Recompiled), sections 7.9.2-7.9.3.
+ *
+ * Web builds only; native builds keep mmap aliasing and page protection.
+ */
+#pragma once
+
+#if !defined(__EMSCRIPTEN__)
+#error "rex/memory/web_guest.h is for the web (Emscripten) build only"
+#endif
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+
+#include <simde/x86/sse2.h>
+
+namespace rex::memory::web {
+
+// Window offsets (relative to the guest base pointer).
+inline constexpr uint64_t kWindowSize = 0xB0000000ull;            // 2.75 GiB
+inline constexpr uint64_t kPhysicalWindowOffset = 0x90000000ull;  // physical memory
+inline constexpr uint32_t kPhysicalSize = 0x20000000u;            // 512 MiB
+
+// Host offset added to `base + guest_address`, by guest_address >> 24. Mirrors
+// the native view table (map_info in src/system/xmemory.cpp).
+inline constexpr std::array<int64_t, 256> kFold = [] {
+  std::array<int64_t, 256> fold{};
+  fold[0x7F] = int64_t(kPhysicalWindowOffset) - 0x7F000000;  // GPU writeback -> physical 0
+  for (uint32_t i = 0x90; i < 0xA0; ++i) {
+    fold[i] = -0x10000000;  // 0x9xxxxxxx aliases 0x8xxxxxxx
+  }
+  for (uint32_t i = 0xA0; i < 0xC0; ++i) {
+    fold[i] = int64_t(kPhysicalWindowOffset) - 0xA0000000;
+  }
+  for (uint32_t i = 0xC0; i < 0xE0; ++i) {
+    fold[i] = int64_t(kPhysicalWindowOffset) - 0xC0000000;
+  }
+  for (uint32_t i = 0xE0; i < 0x100; ++i) {
+    fold[i] = int64_t(kPhysicalWindowOffset) - 0xE0000000 + 0x1000;  // physical + 0x1000
+  }
+  return fold;
+}();
+
+// Dirty bitmap over guest physical memory, 1 bit per 4 KiB page, and a summary
+// with 1 bit per bitmap word. Defined by the runtime (memory_emscripten.cpp).
+inline constexpr uint32_t kPageShift = 12;
+inline constexpr uint32_t kPageCount = kPhysicalSize >> kPageShift;  // 131,072
+extern std::atomic<uint64_t> g_dirty[kPageCount / 64];
+extern std::atomic<uint64_t> g_dirty_summary[kPageCount / 64 / 64];
+// base + kPhysicalWindowOffset; set when guest memory is created.
+extern uint8_t* g_physical_base;
+
+// Marks the pages of a completed write of `size` bytes at host pointer `p`
+// (any guest address form). Not physical memory: nothing to do.
+inline void MarkHostWrite(const void* p, uint32_t size) {
+  uint64_t offset = uintptr_t(p) - uintptr_t(g_physical_base);
+  if (!g_physical_base || size == 0 || offset >= kPhysicalSize) {
+    return;
+  }
+  uint64_t last = (offset + size - 1) >> kPageShift;
+  for (uint64_t page = offset >> kPageShift; page <= last && page < kPageCount; ++page) {
+    uint64_t bit = uint64_t(1) << (page & 63);
+    std::atomic<uint64_t>& word = g_dirty[page >> 6];
+    // An RMW must observe a concurrent consumer's clear, not a stale relaxed load.
+    if (!(word.fetch_or(bit, std::memory_order_release) & bit)) {
+      g_dirty_summary[page >> 12].fetch_or(uint64_t(1) << ((page >> 6) & 63),
+                                           std::memory_order_release);
+    }
+  }
+}
+
+// Guest stores (the recompiler's REX_STORE_* etc. on the web): the store, then
+// the mark. Same byte order and truncation as the native macros.
+inline void Store8(uint8_t* p, uint8_t value) {
+  *reinterpret_cast<volatile uint8_t*>(p) = value;
+  MarkHostWrite(p, 1);
+}
+inline void Store16(uint8_t* p, uint16_t value) {
+  *reinterpret_cast<volatile uint16_t*>(p) = __builtin_bswap16(value);
+  MarkHostWrite(p, 2);
+}
+inline void Store32(uint8_t* p, uint32_t value) {
+  *reinterpret_cast<volatile uint32_t*>(p) = __builtin_bswap32(value);
+  MarkHostWrite(p, 4);
+}
+inline void Store64(uint8_t* p, uint64_t value) {
+  *reinterpret_cast<volatile uint64_t*>(p) = __builtin_bswap64(value);
+  MarkHostWrite(p, 8);
+}
+inline void Store128(uint8_t* p, simde__m128i value) {
+  simde_mm_store_si128(reinterpret_cast<simde__m128i*>(p), value);
+  MarkHostWrite(p, 16);
+}
+template <typename E, typename D>
+inline bool Cas32(uint8_t* p, E expected, D desired) {
+  bool stored = __sync_bool_compare_and_swap(reinterpret_cast<uint32_t*>(p), expected, desired);
+  if (stored) {
+    MarkHostWrite(p, 4);
+  }
+  return stored;
+}
+template <typename E, typename D>
+inline bool Cas64(uint8_t* p, E expected, D desired) {
+  bool stored = __sync_bool_compare_and_swap(reinterpret_cast<uint64_t*>(p), expected, desired);
+  if (stored) {
+    MarkHostWrite(p, 8);
+  }
+  return stored;
+}
+inline void Zero(uint8_t* p, uint32_t size) {
+  std::memset(p, 0, size);
+  MarkHostWrite(p, size);
+}
+
+// Runtime (memory_emscripten.cpp).
+// The zero-filled guest window, reserved on the first call; nullptr if linear
+// memory cannot hold it. Never freed; later calls return the same window.
+uint8_t* AllocateGuestWindow();
+// Host-side writers (kernel, CRT hooks, file reads, audio): marks a completed
+// write of `size` bytes at a guest address in any of its forms.
+void MarkGuestWrite(uint32_t guest_address, uint32_t size);
+
+}  // namespace rex::memory::web
