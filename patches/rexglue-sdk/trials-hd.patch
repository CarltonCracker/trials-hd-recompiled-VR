+  }
+  void MarkDraw() {
+    ++pass_draws_;
+    ++slot_counters_[recording_slot_].draws;
+  }
+  void MarkBindCompute(ExternalComputeRole role) {
+    compute_role_ = role < ExternalComputeRole::kCount ? role : ExternalComputeRole::kOther;
+  }
+  uint32_t MarkDispatch() {
+    between_mask_ |= 4;
+    return Mark(kCategoryDispatch | (uint32_t(compute_role_) << 8));
+  }
+  uint32_t MarkBarrier(uint32_t buffer_barriers, uint32_t image_barriers) {
+    Counters& counters = slot_counters_[recording_slot_];
+    counters.buffer_barriers += buffer_barriers;
+    counters.image_barriers += image_barriers;
+    between_mask_ |= 2;
+    return Mark(kCategoryBarrier);
+  }
+  uint32_t MarkCopyBuffer(uint64_t bytes) {
+    Counters& counters = slot_counters_[recording_slot_];
