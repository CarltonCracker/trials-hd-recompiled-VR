+bool VulkanTextureCache::AcquireResolveImageTarget(uint32_t dest_base, uint32_t dest_pitch_div_32,
+                                                   uint32_t start, uint32_t length, bool scaled,
+                                                   VkDescriptorSetLayout layout,
+                                                   ResolveImageTarget& target_out) {
+  if (std::find(resolve_image_disabled_bases_.begin(), resolve_image_disabled_bases_.end(),
+                start) != resolve_image_disabled_bases_.end()) {
+    trials::CountFallback(trials::Fallback::kResolveImageStaleLoad);
+    return false;
+  }
+  // Textures are rarely created or destroyed while riding - reuse the lookup.
+  ResolveImageOverlapCache& overlap_cache = resolve_image_overlap_cache_[start];
+  if (overlap_cache.textures.empty() || overlap_cache.generation != textures_generation() ||
+      overlap_cache.length != length) {
+    overlap_cache.textures.clear();
+    GetTexturesOverlapping(start, length, overlap_cache.textures);
+    overlap_cache.generation = textures_generation();
+    overlap_cache.length = length;
+  }
+  std::vector<Texture*>& overlapping = overlap_cache.textures;
+  if (overlapping.empty()) {
+    trials::CountFallback(trials::Fallback::kResolveImageNoTexture);
+    return false;
+  }
+  auto* texture = static_cast<VulkanTexture*>(overlapping.front());
+  const TextureKey& key = texture->key();
+  // 32bpp tiled textures are laid out in rows of 32x32 tiles of 4 KB, so a
+  // destination a whole number of tile rows into the texture starts at a row.
+  uint32_t texture_base = key.base_page << 12;
+  uint32_t dest_offset = (dest_base & 0x1FFFFFFF) - texture_base;
+  uint32_t tile_row_bytes = uint32_t(key.pitch) << 12;
+  if (overlapping.size() != 1 || !texture->resolve_storable() ||
+      (dest_base & 0x1FFFFFFF) < texture_base || !tile_row_bytes ||
+      dest_offset % tile_row_bytes || (dest_offset / tile_row_bytes) * 32 >= key.GetHeight() ||
+      key.pitch != dest_pitch_div_32 || bool(key.scaled_resolve) != scaled ||
+      texture->GetGuestMipsSize()) {
+    trials::CountFallback(trials::Fallback::kResolveImageTextureMismatch);
+    return false;
+  }
+  if (texture->outdated_mask()) {
+    trials::CountFallback(trials::Fallback::kResolveImageTextureOutdated);
+    return false;
+  }
+  VkDescriptorSet descriptor_set = texture->GetResolveImageDescriptorSet(layout);
+  if (descriptor_set == VK_NULL_HANDLE) {
+    trials::CountFallback(trials::Fallback::kResolveImageTextureMismatch);
+    return false;
+  }
+  texture->MarkAsUsed();
+  // Also orders consecutive resolves into the same texture.
+  VulkanTexture::Usage old_usage = texture->SetUsage(VulkanTexture::Usage::kComputeWrite);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kComputeWrite, dst_stage_mask, dst_access_mask,
+                       new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      texture->image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout,
+      VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  target_out.texture = texture;
+  target_out.descriptor_set = descriptor_set;
+  target_out.texture_endian = key.endianness;
+  target_out.dest_y = (dest_offset / tile_row_bytes) * 32;
+  return true;
+}
+
+void VulkanTextureCache::FinishResolveImageTarget(const ResolveImageTarget& target, uint32_t start,
+                                                  uint32_t length) {
+  auto* texture = static_cast<VulkanTexture*>(target.texture);
+  {
+    // MarkRangeAsResolved has invalidated it, but it holds the result already.
+    auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+    texture->MakeUpToDateAndWatch(global_lock);
+  }
+  for (std::pair<uint32_t, uint32_t>& range : resolve_image_ranges_) {
+    if (range.first == start) {
+      range.second = std::max(range.second, length);
+      return;
+    }
+  }
+  resolve_image_ranges_.emplace_back(start, length);
+}
+
+void VulkanTextureCache::NoteResolveWrittenToMemory(uint32_t start, uint32_t length) {
+  uint64_t end = uint64_t(start) + length;
+  resolve_image_ranges_.erase(
+      std::remove_if(resolve_image_ranges_.begin(), resolve_image_ranges_.end(),
+                     [&](const std::pair<uint32_t, uint32_t>& range) {
+                       return range.first >= start && uint64_t(range.first) + range.second <= end;
+                     }),
+      resolve_image_ranges_.end());
 }
 
