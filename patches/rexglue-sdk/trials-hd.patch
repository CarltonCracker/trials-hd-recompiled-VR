+  #define const_buffer_end_xe(name) \
+      };
+  #define const_buffer_binding_xe(name, msl_buffer) \
+      constant name##_xe_struct& name [[msl_buffer]]
+  #define constant_xe(const_buffer_name, constant_name) \
