new file mode 100644
index 0000000..4155460
--- /dev/null
+++ b/include/rex/ppc/web_fma.h
@@ -0,0 +1,23 @@
+// Exact double FMA for the generated single-precision forms (caller rounds to float).
+#pragma once
+
+#include <cmath>
+#include <limits>
+
+namespace rex::ppc {
+
+inline double FmaSingle(double a, double b, double c) noexcept {
+#if defined(__clang__)
+#pragma clang fp contract(off)
+#endif
+  static_assert(std::numeric_limits<float>::digits == 24 &&
+                std::numeric_limits<double>::digits == 53);
+  // Two finite float operands have an exact, non-overflowing 48-bit double product.
+  if (std::isfinite(a) && std::isfinite(b) && std::isfinite(c) &&
+      double(float(a)) == a && double(float(b)) == b) {
+    return a * b + c;
+  }
+  return std::fma(a, b, c);
+}
+
+}  // namespace rex::ppc
