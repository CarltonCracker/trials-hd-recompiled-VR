+        spv::Id is_integer = builder_->createBinOp(
+            spv::OpINotEqual, type_bool_,
+            builder_->createBinOp(spv::OpBitwiseAnd, type_uint_, fetch_constant_word_3,
+                                  builder_->makeUintConstant(1)),
+            const_uint_0_);
+        spv::Id texture_format = builder_->createBinOp(
+            spv::OpBitwiseAnd, type_uint_, load_fetch_constant_word(1),
+            builder_->makeUintConstant(63));
+        auto is_format = [&](std::initializer_list<xenos::TextureFormat> formats) {
+          spv::Id any = spv::NoResult;
+          for (xenos::TextureFormat format : formats) {
+            spv::Id equal = builder_->createBinOp(spv::OpIEqual, type_bool_, texture_format,
+                                                  builder_->makeUintConstant(uint32_t(format)));
