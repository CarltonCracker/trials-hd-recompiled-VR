diff --git a/src/graphics/shaders/xesl/resolve_full_32bpp_image.xesli b/src/graphics/shaders/xesl/resolve_full_32bpp_image.xesli
new file mode 100644
index 0000000..e8aa3d9
--- /dev/null
+++ b/src/graphics/shaders/xesl/resolve_full_32bpp_image.xesli
@@ -0,0 +1,249 @@
+/**
+ * Trials HD fast path (G3): a 32bpp resolve written straight into the host
+ * image of the texture that samples the destination, instead of the guest
+ * tiled layout in shared memory / the scaled resolve buffer (which the texture
+ * cache would then untile and copy into the same image).
+ *
+ * The texels are the same 32-bit words the tiled path would produce for a
+ * texture loaded with the plain 32bpb copy loader: the resolve's packing and
+ * destination endian swap, then the texture's endian swap. They are stored
+ * through an R32_UINT view of the texture image.
+ *
+ * XE_RESOLVE_IMAGE_RAW: one-to-one copy of the selected sample's EDRAM words
+ * (what the fast 32bpp resolve does), with the red / blue swap applied to
+ * 8_8_8_8 and 2_10_10_10 (the caller only uses it for those when swapping);
+ * otherwise the full 32bpp conversion.
+ *
+ * The destination may start below row 0 of the texture (xe_resolve_image_dest_y,
+ * host rows): resolves into parts of a taller texture, such as a shadow atlas.
+ *
+ * XE_RESOLVE_IMAGE_FROM_RT: instead of the EDRAM buffer the render targets were
+ * dumped to, the source is read straight from the host render target owning
+ * the whole source region (same format, pitch and MSAA as the resolve), with
+ * the dump's addressing and packing per EDRAM word - so the dump dispatch is
+ * skipped. XE_RESOLVE_IMAGE_RT_MSAA: 4x MSAA render target;
+ * XE_RESOLVE_IMAGE_RT_UINT: k_16_16 through its R16G16_UINT transfer view
+ * (otherwise 8_8_8_8 or 2_10_10_10 through a float view).
+ *
+ * Only for Vulkan (GLSL).
+ */
+
+#ifdef XE_RESOLVE_IMAGE_FROM_RT
+  #include "xesl.xesli"
+  // Every EDRAM word the resolve reads comes from XeResolveRtLoad (defined
+  // below, once the push constants are declared).
+  uint XeResolveRtLoad(uint address_ints);
+  #undef uint_vector_buffer_load1_xe
+  #undef uint_vector_buffer_load2_xe
+  #undef uint_vector_buffer_load4_xe
+  #define uint_vector_buffer_load1_xe(name, position) XeResolveRtLoad(position)
+  #define uint_vector_buffer_load2_xe(name, position) \
+      uint2_xe(XeResolveRtLoad(position), XeResolveRtLoad((position) + 1u))
+  #define uint_vector_buffer_load4_xe(name, position)                         \
+      uint4_xe(XeResolveRtLoad(position), XeResolveRtLoad((position) + 1u), \
+               XeResolveRtLoad((position) + 2u), XeResolveRtLoad((position) + 3u))
+#endif
+
+#include "endian.xesli"
+#include "pixel_formats.xesli"
+#define XE_RESOLVE_COPY_EDRAM_IS_UINT_VECTOR_BUFFER
+#define XE_RESOLVE_IMAGE
+#include "resolve.xesli"
+
+#if !SHADING_LANGUAGE_GLSL_XE
+  #error resolve_full_32bpp_image is only implemented for GLSL
+#endif
+
+layout(set = 1, binding = 0, r32ui) uniform restrict writeonly uimage2D xe_resolve_dest_image;
+
+#ifdef XE_RESOLVE_IMAGE_FROM_RT
+  #ifdef XE_RESOLVE_IMAGE_RT_UINT
+    #ifdef XE_RESOLVE_IMAGE_RT_MSAA
+      layout(set = 2, binding = 0) uniform utexture2DMS xe_resolve_rt;
+    #else
+      layout(set = 2, binding = 0) uniform utexture2D xe_resolve_rt;
+    #endif
+  #else
+    #ifdef XE_RESOLVE_IMAGE_RT_MSAA
+      layout(set = 2, binding = 0) uniform texture2DMS xe_resolve_rt;
+    #else
+      layout(set = 2, binding = 0) uniform texture2D xe_resolve_rt;
+    #endif
+  #endif
+
+  // Address of the first EDRAM word of up to two sample rows (within one tile)
+  // this invocation has read, and the render target sample it maps to: the
+  // resolve reads 4 consecutive pixels from one or two rows, so the divisions
+  // of the full mapping are needed once per row.
+  uint xe_resolve_rt_row_address[2] = {0xFFFFFFFFu, 0xFFFFFFFFu};
+  uint2_xe xe_resolve_rt_row_sample[2];
+  uint xe_resolve_rt_row_next = 0u;
+
+  // The EDRAM word at address_ints as the render target dump would have
+  // written it (VulkanRenderTargetCache::GetDumpPipeline: sample addressing
+  // and the packing of the formats this path is used for).
+  uint XeResolveRtLoad(uint address_ints) {
+    #ifdef XE_RESOLVE_RESOLUTION_SCALED
+      uint2_xe scale =
+          (uint_x2_xe(push_const_xe(xe_resolve_coordinate_info)) >> uint2_xe(16u, 19u)) & 7u;
+    #else
+      uint2_xe scale = uint_x2_xe(1u);
+    #endif
+    uint2_xe tile_size = uint2_xe(80u, 16u) * scale;
+    uint edram_info = push_const_xe(xe_resolve_edram_info);
+    uint2_xe rt_sample;
+    if (address_ints - xe_resolve_rt_row_address[0] < tile_size.x) {
+      rt_sample = xe_resolve_rt_row_sample[0] +
+                  uint2_xe(address_ints - xe_resolve_rt_row_address[0], 0u);
+    } else if (address_ints - xe_resolve_rt_row_address[1] < tile_size.x) {
+      rt_sample = xe_resolve_rt_row_sample[1] +
+                  uint2_xe(address_ints - xe_resolve_rt_row_address[1], 0u);
+    } else {
+      uint tile_ints = tile_size.x * tile_size.y;
+      uint tile = address_ints / tile_ints;
+      uint tile_offset = address_ints - tile * tile_ints;
+      uint tile_row = tile_offset / tile_size.x;
+      uint tile_column = tile_offset - tile_row * tile_size.x;
+      uint pitch_tiles = edram_info & ((1u << 10u) - 1u);
+      uint rt_tile = (tile - push_const_xe(xe_resolve_image_rt_base_tiles)) & 2047u;
+      uint2_xe row_sample =
+          uint2_xe(rt_tile % pitch_tiles, rt_tile / pitch_tiles) * tile_size +
+          uint2_xe(0u, tile_row);
+      xe_resolve_rt_row_address[xe_resolve_rt_row_next] = address_ints - tile_column;
+      xe_resolve_rt_row_sample[xe_resolve_rt_row_next] = row_sample;
+      xe_resolve_rt_row_next ^= 1u;
+      rt_sample = row_sample + uint2_xe(tile_column, 0u);
+    }
+    #ifdef XE_RESOLVE_IMAGE_RT_MSAA
+      // 4x: bit 0 of the host sample index is horizontal, bit 1 vertical.
+      int sample_index = int((rt_sample.x & 1u) | ((rt_sample.y & 1u) << 1u));
+      int2_xe rt_pixel = int2_xe(rt_sample >> 1u);
+    #else
+      int sample_index = 0;
+      int2_xe rt_pixel = int2_xe(rt_sample);
+    #endif
+    #ifdef XE_RESOLVE_IMAGE_RT_UINT
+      uint4_xe texel = texelFetch(xe_resolve_rt, rt_pixel, sample_index);
+      return bitfieldInsert(texel.x, texel.y, 16, 16);
+    #else
+      float4_xe texel = texelFetch(xe_resolve_rt, rt_pixel, sample_index);
+      uint packed;
+      dont_flatten_xe
+      if (((edram_info >> 24u) & 15u) == kXenosColorRenderTargetFormat_8_8_8_8) {
+        packed = uint(texel.x * 255.0f + 0.5f);
+        packed = bitfieldInsert(packed, uint(texel.y * 255.0f + 0.5f), 8, 8);
+        packed = bitfieldInsert(packed, uint(texel.z * 255.0f + 0.5f), 16, 8);
+        packed = bitfieldInsert(packed, uint(texel.w * 255.0f + 0.5f), 24, 8);
+      } else {
+        // 2_10_10_10 / 2_10_10_10_AS_10_10_10_10.
+        packed = uint(texel.x * 1023.0f + 0.5f);
+        packed = bitfieldInsert(packed, uint(texel.y * 1023.0f + 0.5f), 10, 10);
+        packed = bitfieldInsert(packed, uint(texel.z * 1023.0f + 0.5f), 20, 10);
+        packed = bitfieldInsert(packed, uint(texel.w * 3.0f + 0.5f), 30, 2);
+      }
+      return packed;
+    #endif
+  }
+#endif
+
+#define LOCAL_SIZE_X_XE 8
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  XE_RESOLVE_PUSH_CONST_BINDING
+  entry_binding_next_xe
+  XE_RESOLVE_COPY_EDRAM_BINDING
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+{
+  // 1 thread = 4 host pixels, as in resolve_full_32bpp.
+  XeResolveInfo resolve_info = XeResolveGetInfo(pass_push_consts_xe);
+  uint2_xe pixel_index = in_global_thread_id_xe.xy << uint2_xe(2u, 0u);
+  dont_flatten_xe
+  if (pixel_index.x >= resolve_info.width_div_8_scaled << 3u) {
+    return;
+  }
+  uint source_address_ints =
+      XeResolveColorCopySourcePixelAddressIntsYHalfPixelOffsetFilling(resolve_info, pixel_index);
+  uint4_xe packed;
+  #ifdef XE_RESOLVE_IMAGE_RAW
+    uint pixel_stride_ints = XeResolveEdramPixelStrideInts(resolve_info);
+    dont_flatten_xe
+    if (pixel_stride_ints == 1u) {
+      packed = uint_vector_buffer_load4_xe(xe_resolve_edram, source_address_ints);
+    } else {
+      packed.x = uint_vector_buffer_load1_xe(xe_resolve_edram, source_address_ints);
+      packed.y = uint_vector_buffer_load1_xe(xe_resolve_edram,
+                                             source_address_ints + pixel_stride_ints);
+      packed.z = uint_vector_buffer_load1_xe(xe_resolve_edram,
+                                             source_address_ints + 2u * pixel_stride_ints);
+      packed.w = uint_vector_buffer_load1_xe(xe_resolve_edram,
+                                             source_address_ints + 3u * pixel_stride_ints);
+    }
+    // Red / blue swap of the formats where it applies (the same fields as the
+    // full resolve unpacks with swapping).
+    dont_flatten_xe
+    if (resolve_info.dest_swap) {
+      dont_flatten_xe
+      if (resolve_info.edram_format == kXenosColorRenderTargetFormat_8_8_8_8 ||
+          resolve_info.edram_format == kXenosColorRenderTargetFormat_8_8_8_8_GAMMA) {
+        packed = (packed & 0xFF00FF00u) | ((packed & 0xFFu) << 16u) | ((packed >> 16u) & 0xFFu);
+      } else {
+        packed = (packed & 0xC00FFC00u) | ((packed & 0x3FFu) << 20u) |
+                 ((packed >> 20u) & 0x3FFu);
+      }
+    }
+  #else
+    float4_xe pixel_0, pixel_1, pixel_2, pixel_3;
+    XeResolveLoad4RGBAColors(
+        pass_uint_vector_buffer_xe(xe_resolve_edram)
+        pass_next_after_uint_vector_buffer_xe
+        resolve_info, source_address_ints, pixel_0, pixel_1, pixel_2, pixel_3);
+    dont_flatten_xe
+    if (resolve_info.dest_format == kXenosFormat_16_16 &&
+        resolve_info.dest_number != 0u) {
+      packed.x = XePackR16G16Number(pixel_0.rg, resolve_info.dest_number);
+      packed.y = XePackR16G16Number(pixel_1.rg, resolve_info.dest_number);
+      packed.z = XePackR16G16Number(pixel_2.rg, resolve_info.dest_number);
+      packed.w = XePackR16G16Number(pixel_3.rg, resolve_info.dest_number);
+    } else {
+      packed = XePack32bpp4Pixels(pixel_0, pixel_1, pixel_2, pixel_3,
+                                  resolve_info.dest_format);
+    }
+  #endif
+  dont_flatten_xe
+  if (pixel_index.x == 0u &&
+      resolve_info.half_pixel_offset_fill_source.x != 0u) {
+    if (resolve_info.half_pixel_offset_fill_source.x >= 2u) {
+      if (resolve_info.half_pixel_offset_fill_source.x >= 3u) {
+        packed.z = packed.w;
+      }
+      packed.y = packed.z;
+    }
+    packed.x = packed.y;
+  }
+  // Guest memory words, then what the texture's copy loader makes of them. The
+  // texture endian is in bits 28:29 of the destination info (unused there).
+  uint texture_endian = (push_const_xe(xe_resolve_dest_info) >> 28u) & 3u;
+  packed = XeEndianSwap32(XeEndianSwap32(packed, resolve_info.dest_endian_128), texture_endian);
+  int2_xe dest = int2_xe(pixel_index + resolve_info.dest_xy_offset_scaled +
+                         uint2_xe(0u, push_const_xe(xe_resolve_image_dest_y)));
+  int2_xe dest_size = imageSize(xe_resolve_dest_image);
+  dont_flatten_xe
+  if (dest.y < dest_size.y) {
+    if (dest.x < dest_size.x) {
+      imageStore(xe_resolve_dest_image, dest, uint4_xe(packed.x, 0u, 0u, 0u));
+    }
+    if (dest.x + 1 < dest_size.x) {
+      imageStore(xe_resolve_dest_image, dest + int2_xe(1, 0), uint4_xe(packed.y, 0u, 0u, 0u));
+    }
+    if (dest.x + 2 < dest_size.x) {
+      imageStore(xe_resolve_dest_image, dest + int2_xe(2, 0), uint4_xe(packed.z, 0u, 0u, 0u));
+    }
+    if (dest.x + 3 < dest_size.x) {
+      imageStore(xe_resolve_dest_image, dest + int2_xe(3, 0), uint4_xe(packed.w, 0u, 0u, 0u));
+    }
+  }
+}
+entry_code_end_compute_xe
