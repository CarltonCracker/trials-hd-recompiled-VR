         /// Reset the spin_wait back to its original state.
         void reset()
         {
+#if defined(__EMSCRIPTEN__)
+            // Each query is a call into JavaScript (os.cpus() under Node);
+            // reset() runs on every wait. The count does not change.
+            static const bool multi_core = std::thread::hardware_concurrency() > 1;
+            m_value = multi_core ? 0 : 10;
+#else
             m_value = std::thread::hardware_concurrency() > 1 ? 0 : 10;
+#endif
         }
         
         /// \brief
