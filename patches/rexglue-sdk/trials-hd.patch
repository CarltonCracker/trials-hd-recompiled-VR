diff --git a/include/rex/ui/web.h b/include/rex/ui/web.h
new file mode 100644
index 0000000..e5478b1
--- /dev/null
+++ b/include/rex/ui/web.h
@@ -0,0 +1,95 @@
+/**
+ * @file        ui/web.h
+ * @brief       Page input, canvas size and UI-thread lock of the web (Emscripten) build
+ *
+ * The page (the app's input module) owns keyboard, pointer and canvas-size
+ * state; the WebWindow drains it on the UI thread and dispatches the usual
+ * window events (keys, text, mouse, focus, size) to its listeners: ImGui,
+ * keybinds and the keyboard input driver. The renderer's GPU worker reads the
+ * canvas size to resize the canvas it owns, and runs the UI drawers (ImGui)
+ * while holding UIMutex(), which the UI thread holds while it runs its work
+ * (docs/web-port/README.md 7.9.5-7.9.7 in Trials HD Recompiled).
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#if !REX_PLATFORM_EMSCRIPTEN
+#error "rex/ui/web.h is for the web (Emscripten) build only"
+#endif
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+namespace rex::ui {
+class ImmediateDrawer;
+class Presenter;
+}  // namespace rex::ui
+
+namespace rex::ui::web {
+
+// One page input event. Types and codes as written by the page:
+//   kKeyDown/kKeyUp: code = SDL scancode.
+//   kText:           code = Unicode code point (one per character).
+//   kPointerMove:    code = buttons held (bit 0 left, 1 right, 2 middle), x/y.
+//   kPointerDown/Up: code = SDL button (1 left, 2 middle, 3 right, 4 X1, 5 X2), x/y.
+//   kWheel:          x/y = DOM deltaX/deltaY in pixels (positive y = down).
+//   kFocus/kBlur:    no payload.
+// Positions are in canvas pixels (CSS pixels times devicePixelRatio, the same
+// space as CanvasState::width/height).
+enum EventType : uint32_t {
+  kKeyDown = 1,
+  kKeyUp = 2,
+  kPointerMove = 3,
+  kPointerDown = 4,
+  kPointerUp = 5,
+  kWheel = 6,
+  kText = 7,
+  kFocus = 8,
+  kBlur = 9,
+};
+struct InputEvent {
+  uint32_t type;
+  uint32_t code;
+  int32_t x;
+  int32_t y;
+};
+
+struct CanvasState {
+  // The canvas's displayed size in device pixels (0 when unknown).
+  uint32_t width = 0;
+  uint32_t height = 0;
+  float device_pixel_ratio = 1.0f;
+  bool visible = true;
+};
+
+struct InputSource {
+  // UI thread only: moves up to `max` queued events into `out` (oldest first)
+  // and returns how many.
+  size_t (*drain_events)(InputEvent* out, size_t max) = nullptr;
+  // Any thread: the current canvas state; false when not known yet.
+  bool (*get_canvas_state)(CanvasState& out) = nullptr;
+};
+
+// Set once by the app before the window opens (e.g. in OnPreSetup).
+void SetInputSource(const InputSource& source);
+const InputSource& GetInputSource();
+bool GetCanvasState(CanvasState& out);
+
+// Held by the UI thread while it runs its pending functions and dispatches
+// page events, and by the GPU worker while it runs the UI drawers. Lock order:
+// UIMutex() before any renderer lock.
+std::recursive_mutex& UIMutex();
+
+// The renderer calls this on the GPU worker once its presenter exists, with an
+// immediate drawer created there; the app (ReXApp) attaches its ImGui drawer
+// to them on the UI thread.
+using PresenterReadyHandler = void (*)(void* context, Presenter* presenter,
+                                       std::unique_ptr<ImmediateDrawer> drawer);
+void SetPresenterReadyHandler(PresenterReadyHandler handler, void* context);
+void NotifyPresenterReady(Presenter* presenter, std::unique_ptr<ImmediateDrawer> drawer);
+
+}  // namespace rex::ui::web
diff --git a/include/rex/ui/window_web.h b/include/rex/ui/window_web.h
new file mode 100644
index 0000000..223ac9f
