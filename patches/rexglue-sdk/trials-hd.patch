+void DeferredCommandBuffer::ProfileCommand(VulkanGpuProfiler& profiler,
+                                           VkCommandBuffer command_buffer, Command command,
+                                           const uintmax_t* stream) {
+  const uint8_t* args_bytes = reinterpret_cast<const uint8_t*>(stream);
+  switch (command) {
+    case Command::kVkBeginRenderPass: {
+      auto& args = *reinterpret_cast<const ArgsVkBeginRenderPass*>(stream);
+      profiler.Stamp(command_buffer, profiler.MarkPassBegin(uint64_t(args.framebuffer)));
+    } break;
+    case Command::kVkBeginRendering: {
+      // Key the pass by its attachment views to see passes re-opening the same targets.
+      auto& args = *reinterpret_cast<const ArgsVkBeginRendering*>(stream);
+      const auto* attachments = reinterpret_cast<const VkRenderingAttachmentInfo*>(
+          args_bytes + rex::align(sizeof(ArgsVkBeginRendering), alignof(VkRenderingAttachmentInfo)));
+      uint32_t attachment_count = args.color_attachment_count + (args.has_depth_attachment ? 1 : 0);
+      uint64_t key = UINT64_C(0x9E3779B97F4A7C15) * (attachment_count + 1);
+      for (uint32_t i = 0; i < attachment_count; ++i) {
+        key = (key ^ uint64_t(attachments[i].imageView)) * UINT64_C(0x100000001B3);
+      }
+      profiler.Stamp(command_buffer,
+                     profiler.MarkPassBegin(key, args.is_transfer, args.profile_label));
+    } break;
+    case Command::kVkEndRenderPass:
+    case Command::kVkEndRendering:
+      profiler.MarkPassEnd();
+      break;
+    case Command::kVkDraw:
+    case Command::kVkDrawIndexed:
+      profiler.MarkDraw();
+      break;
+    case Command::kVkBindPipeline: {
+      auto& args = *reinterpret_cast<const ArgsVkBindPipeline*>(stream);
+      if (args.pipeline_bind_point == VK_PIPELINE_BIND_POINT_COMPUTE) {
+        profiler.MarkBindCompute(args.compute_role);
+      }
+    } break;
+    case Command::kVkDispatch:
+      profiler.Stamp(command_buffer, profiler.MarkDispatch());
+      break;
+    case Command::kVkPipelineBarrier: {
+      auto& args = *reinterpret_cast<const ArgsVkPipelineBarrier*>(stream);
+      profiler.Stamp(command_buffer, profiler.MarkBarrier(args.buffer_memory_barrier_count,
+                                                          args.image_memory_barrier_count));
+    } break;
+    case Command::kVkCopyBuffer: {
+      auto& args = *reinterpret_cast<const ArgsVkCopyBuffer*>(stream);
+      const auto* regions = reinterpret_cast<const VkBufferCopy*>(
+          args_bytes + rex::align(sizeof(ArgsVkCopyBuffer), alignof(VkBufferCopy)));
+      uint64_t bytes = 0;
+      for (uint32_t i = 0; i < args.region_count; ++i) {
+        bytes += regions[i].size;
+      }
+      profiler.Stamp(command_buffer, profiler.MarkCopyBuffer(bytes));
+    } break;
+    case Command::kVkCopyBufferToImage:
+    case Command::kVkClearColorImage:
+      profiler.Stamp(command_buffer, profiler.MarkCopyImage());
+      break;
+    default:
+      break;
+  }
+}
