diff --git a/src/core/fma_emscripten.cpp b/src/core/fma_emscripten.cpp
new file mode 100644
index 0000000..9af197b
--- /dev/null
+++ b/src/core/fma_emscripten.cpp
@@ -0,0 +1,54 @@
+/**
+ * @file        core/fma_emscripten.cpp
+ * @brief       Fast exact fma() for the web (Emscripten) build
+ *
+ * WebAssembly has no fused multiply-add instruction, so fma() is musl's
+ * software routine, which costs more than everything else in the game's job
+ * threads while it loads (double-precision fmadd chains in its math code).
+ * The relaxed-SIMD f64x2.relaxed_madd may be fused or not, depending on the
+ * engine and CPU; Chromium uses the CPU's FMA instruction when it has one. At
+ * startup a case whose fused and unfused results differ decides: if the
+ * hardware result is fused it is exact, and every fma() call uses it;
+ * otherwise musl's exact routine stays.
+ *
+ * The link wraps the symbol (-Wl,--wrap=fma): calls to fma() reach
+ * __wrap_fma, and __real_fma is musl's.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_EMSCRIPTEN
+
+#include <wasm_simd128.h>
+
+extern "C" double __real_fma(double a, double b, double c);
+
+namespace {
+
+inline double RelaxedMadd(double a, double b, double c) {
+  return wasm_f64x2_extract_lane(
+      wasm_f64x2_relaxed_madd(wasm_f64x2_splat(a), wasm_f64x2_splat(b), wasm_f64x2_splat(c)),
+      0);
+}
+
+bool RelaxedMaddIsFused() {
+  // (1 + 2^-30)(1 - 2^-30) - 1 is exactly -2^-60 when fused; rounding the
+  // product first gives 1 - 1 = 0. Volatile: computed at run time.
+  volatile double a = 1.0 + 0x1p-30;
+  volatile double b = 1.0 - 0x1p-30;
+  volatile double c = -1.0;
+  return RelaxedMadd(a, b, c) == -0x1p-60;
+}
+
+const bool kFusedMadd = RelaxedMaddIsFused();
+
+}  // namespace
+
+extern "C" double __wrap_fma(double a, double b, double c) {
+  if (kFusedMadd) {
+    return RelaxedMadd(a, b, c);
+  }
+  return __real_fma(a, b, c);
+}
+
+#endif  // REX_PLATFORM_EMSCRIPTEN
diff --git a/src/core/frame_timing.cpp b/src/core/frame_timing.cpp
new file mode 100644
index 0000000..b9b4ac5
--- /dev/null
+++ b/src/core/frame_timing.cpp
@@ -0,0 +1,135 @@
+/**
+ * @file        core/frame_timing.cpp
+ * @brief       Measured frame rate and frame times (rex/perf/frame_timing.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/perf/frame_timing.h>
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <mutex>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(log_frame_timing, false, "GPU",
+                    "Log the measured frame rate and frame times once per second");
+
+namespace rex::perf {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+constexpr int64_t kSecond = 1'000'000'000;
+// Frame timestamps (ns): 10 s of history even at 800 FPS.
+constexpr size_t kHistory = 8192;
+// Statistics are recomputed at most this often, so a display stays readable.
+constexpr int64_t kRefresh = 100'000'000;
+
+std::mutex g_mutex;
+std::array<int64_t, kHistory> g_frames;
+uint64_t g_count = 0;  // frames recorded; the newest is g_frames[(g_count - 1) % kHistory]
+int64_t g_last_log = 0;
+int64_t g_computed_at = 0;
+FrameTiming g_cached;
+
+int64_t Now() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch())
+      .count();
+}
+
+int64_t FrameAt(uint64_t index) {
+  return g_frames[index % kHistory];
+}
+
+// g_mutex held.
+FrameTiming Compute(int64_t now) {
+  FrameTiming t;
+  t.total_frames = g_count;
+  if (g_count == 0) {
+    return t;
+  }
+  const uint64_t available = std::min<uint64_t>(g_count, kHistory);
+  const uint64_t newest = g_count - 1;
+  const uint64_t oldest = g_count - available;
+  // Frames finished in the last second; frame times ending in it.
+  uint32_t in_second = 0;
+  double sum_ms = 0;
+  uint32_t intervals = 0;
+  double worst_ms = double(now - FrameAt(newest)) / 1e6;  // the frame in progress
+  std::vector<double> last_10s;
+  last_10s.reserve(available);
+  for (uint64_t i = newest + 1; i-- > oldest;) {
+    const int64_t at = FrameAt(i);
+    if (now - at > 10 * kSecond) {
+      break;
+    }
+    const bool recent = now - at <= kSecond;
+    in_second += recent;
+    if (i > oldest) {
+      const double ms = double(at - FrameAt(i - 1)) / 1e6;
+      last_10s.push_back(ms);
+      if (recent) {
+        sum_ms += ms;
+        ++intervals;
+        worst_ms = std::max(worst_ms, ms);
+      }
+    }
+  }
+  // Right after the first frame, the rate is over the time since then.
+  const int64_t span = std::min<int64_t>(kSecond, now - FrameAt(oldest));
+  t.fps = span > 0 ? in_second * double(kSecond) / double(span) : 0;
+  t.avg_frame_ms = intervals ? sum_ms / intervals : 0;
+  t.worst_frame_ms = worst_ms;
+  if (!last_10s.empty()) {
+    auto p99 = last_10s.begin() + ptrdiff_t(double(last_10s.size() - 1) * 0.99);
+    std::nth_element(last_10s.begin(), p99, last_10s.end());
+    t.low_1pct_fps = *p99 > 0 ? 1000.0 / *p99 : 0;
+  }
+  return t;
+}
+
+}  // namespace
+
+void RecordGuestFrame() {
+  const int64_t now = Now();
+  std::lock_guard lock(g_mutex);
+  g_frames[g_count % kHistory] = now;
+  ++g_count;
+  if (REXCVAR_GET(log_frame_timing) && now - g_last_log >= kSecond) {
+    if (g_last_log) {
+      const FrameTiming t = Compute(now);
+      REXLOG_INFO("frame timing: {:.1f} FPS, avg {:.2f} ms, worst {:.2f} ms, 1% low {:.1f} FPS",
+                  t.fps, t.avg_frame_ms, t.worst_frame_ms, t.low_1pct_fps);
+    }
+    g_last_log = now;
+  }
+}
+
+FrameTiming GetFrameTiming() {
+  const int64_t now = Now();
+  std::lock_guard lock(g_mutex);
+  if (now - g_computed_at >= kRefresh) {
+    g_cached = Compute(now);
+    g_computed_at = now;
+  }
+  return g_cached;
+}
+
+size_t GetRecentFrameTimes(float* out, size_t max_count) {
+  std::lock_guard lock(g_mutex);
+  const uint64_t available = std::min<uint64_t>(g_count, kHistory);
+  const size_t n = size_t(std::min<uint64_t>(available ? available - 1 : 0, max_count));
+  for (size_t k = 0; k < n; ++k) {
+    const uint64_t i = g_count - n + k;  // interval ending at frame i
+    out[k] = float(double(FrameAt(i) - FrameAt(i - 1)) / 1e6);
+  }
+  return n;
+}
+
+}  // namespace rex::perf
