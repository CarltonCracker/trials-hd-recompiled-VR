+          attachment.clearValue.color.uint32[1] = component_1;
+        } else {
+          std::memcpy(&attachment.clearValue.color.float32[0], &component_0,
+                      sizeof(component_0));
+          std::memcpy(&attachment.clearValue.color.float32[1], &component_1,
+                      sizeof(component_1));
+        }
+      } break;
+    }
+  }
