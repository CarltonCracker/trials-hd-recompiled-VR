@@ -0,0 +1,30 @@
+/**
+ * @file        thread/web.h
+ * @brief       Threads in the web (Emscripten) build: canvases and yielding
+ *
+ * A browser worker presents its canvas and delivers WebGPU callbacks only
+ * when it returns to its event loop; JSPI lets C++ do that without unwinding
+ * (docs/web-port/README.md 7.4 and 7.9.5 in Trials HD Recompiled).
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#if !REX_PLATFORM_EMSCRIPTEN
+#error "rex/thread/web.h is for the web (Emscripten) build only"
+#endif
+
+namespace rex::thread::web {
+
+// The next thread created by rex::thread::Thread::Create (from any thread)
+// receives these canvases (comma-separated CSS selectors, "#canvas" for the
+// page's canvas) as OffscreenCanvases it owns. Pass nullptr to clear.
+void SetTransferredCanvasesForNextThread(const char* selectors);
+
+// Returns to this worker's event loop once (the canvas presents, WebGPU
+// callbacks run) and resumes. Needs -sJSPI; not a timer, so repeated calls
+// are not clamped to 4 ms.
+void YieldToEventLoop();
+
+}  // namespace rex::thread::web
