+  // Invalidates the destination's textures (and marks scaled resolve pages),
+  // then the target texture is made up to date again - it holds the result.
+  texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_extent_start,
+                                    resolve_info.copy_dest_extent_length);
+  texture_cache.FinishResolveImageTarget(target, resolve_info.copy_dest_extent_start,
+                                         resolve_info.copy_dest_extent_length);
+  trials::CountStat(trials::Stat::kResolvesToImage);
+  return true;
+}
