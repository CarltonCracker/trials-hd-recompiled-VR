+/**
+ * @file        ui/web/windowed_app_context_web.cpp
+ * @brief       UI loop of the web (Emscripten) build
+ */
+
+#include <rex/ui/windowed_app_context_web.h>
+
+#include <chrono>
+#include <cstdlib>
+
+#include <rex/ui/web.h>
+#include <rex/ui/window_web.h>
+
+namespace rex::ui {
+
+WebWindowedAppContext::~WebWindowedAppContext() {
+  // As the SDL context does: run what is left before the loop goes away.
+  ExecutePendingFunctionsFromUIThread();
+}
+
+void WebWindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  {
+    std::lock_guard<std::mutex> lock(wake_mutex_);
+    wake_pending_ = true;
+  }
+  wake_.notify_one();
+}
+
+void WebWindowedAppContext::PlatformQuitFromUIThread() {
+  NotifyUILoopOfPendingFunctions();
+}
+
+int WebWindowedAppContext::RunMainMessageLoop() {
+  // The page's input arrives in shared memory without a wake-up, so poll it
+  // every few milliseconds (rex/ui/web.h); queued functions wake at once.
+  constexpr auto kPagePollInterval = std::chrono::milliseconds(4);
+  while (!HasQuitFromUIThread()) {
+    {
+      std::unique_lock<std::mutex> lock(wake_mutex_);
+      wake_.wait_for(lock, kPagePollInterval, [this] { return wake_pending_; });
+      wake_pending_ = false;
+    }
+    // The GPU worker runs the UI drawers (ImGui) under the same lock.
+    std::lock_guard ui_lock(web::UIMutex());
+    ExecutePendingFunctionsFromUIThread();
+    if (!HasQuitFromUIThread()) {
+      WebWindow::PumpPageEvents();
+    }
+  }
+  return EXIT_SUCCESS;
+}
+
+}  // namespace rex::ui
