+void CountFallback(Fallback fallback, uint32_t count) {
+  g_fallbacks[size_t(fallback)].fetch_add(count, std::memory_order_relaxed);
+}
+
+void CountStat(Stat stat, uint32_t count) {
+  g_stats[size_t(stat)].fetch_add(count, std::memory_order_relaxed);
+}
+
+std::string TakeReport(uint32_t frames) {
+  double scale = frames ? 1.0 / frames : 1.0;
+  std::string stats, fallbacks;
+  for (size_t i = 0; i < size_t(Stat::kCount); ++i) {
+    if (uint64_t n = g_stats[i].exchange(0, std::memory_order_relaxed)) {
+      stats += fmt::format(" {}={:.1f}", kStatNames[i], n * scale);
+    }
+  }
+  for (size_t i = 0; i < size_t(Fallback::kCount); ++i) {
+    if (uint64_t n = g_fallbacks[i].exchange(0, std::memory_order_relaxed)) {
+      fallbacks += fmt::format(" {}={}", kFallbackNames[i], n);
+    }
+  }
+  std::string report;
+  if (!stats.empty()) {
+    report += " fast path/frame:" + stats;
+  }
+  if (!fallbacks.empty()) {
+    report += " fallbacks:" + fallbacks;
+  }
+  return report;
+}
