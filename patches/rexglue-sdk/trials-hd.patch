+bool VulkanRenderTargetCache::TryResolveCopyToImage(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader,
+    const draw_util::ResolveCopyShaderConstants& copy_shader_constants, bool draw_resolution_scaled,
+    VulkanTextureCache& texture_cache) {
+  if (!trials::Enabled() || GetPath() != Path::kHostRenderTargets ||
+      resolve_image_raw_pipeline_ == VK_NULL_HANDLE ||
+      resolve_image_full_pipeline_ == VK_NULL_HANDLE) {
+    return false;
+  }
+  bool raw;
+  switch (copy_shader) {
+    case draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA:
+    case draw_util::ResolveCopyShaderIndex::kFast32bpp4xMSAA:
+      raw = true;
+      break;
+    case draw_util::ResolveCopyShaderIndex::kFull32bpp:
+      raw = false;
+      break;
+    default:
+      trials::CountFallback(trials::Fallback::kResolveImageUnsupported);
+      return false;
+  }
+  const reg::RB_COPY_DEST_INFO& dest_info = resolve_info.copy_dest_info;
+  // Depth needs the texture loader's float24 conversion; 64- and 128-bit
+  // endian swaps move words between texels; the CPU reads its own copy of
+  // read-back resolves from guest memory.
+  // The raw copy swaps red and blue only for 8_8_8_8 and 2_10_10_10.
+  bool raw_swap_supported = false;
+  switch (xenos::ColorRenderTargetFormat(resolve_info.color_edram_info.format)) {
+    case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+    case xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT_AS_16_16_16_16:
+      raw_swap_supported = true;
+      break;
+    default:
+      break;
+  }
+  if (resolve_info.IsCopyingDepth() || dest_info.copy_dest_array ||
+      uint32_t(dest_info.copy_dest_endian) > uint32_t(xenos::Endian128::k16in32) ||
+      (raw && dest_info.copy_dest_swap && !raw_swap_supported) ||
+      command_processor_.WouldReadBackResolve(resolve_info.copy_dest_extent_length)) {
+    trials::CountFallback(trials::Fallback::kResolveImageUnsupported);
+    return false;
+  }
+  VulkanTextureCache::ResolveImageTarget target;
+  if (!texture_cache.AcquireResolveImageTarget(
+          resolve_info.copy_dest_base, resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32,
+          resolve_info.copy_dest_extent_start, resolve_info.copy_dest_extent_length,
+          draw_resolution_scaled, resolve_image_descriptor_set_layout_, target)) {
+    return false;
+  }
+
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  bool source_is_uint = false;
+  VulkanRenderTarget* source_rt = GetResolveImageSourceRenderTarget(
+      resolve_info, dump_base, dump_row_length_used, dump_rows, dump_pitch, source_is_uint);
+  VkPipeline pipeline;
+  VkPipelineLayout pipeline_layout;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  if (source_rt) {
+    // Read the render target directly (the same barrier as for dumping it).
+    command_processor_.PushImageMemoryBarrier(
+        source_rt->image(), ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT),
+        source_rt->current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        source_rt->current_access_mask(), VK_ACCESS_SHADER_READ_BIT, source_rt->current_layout(),
+        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    source_rt->SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    pipeline = resolve_image_rt_pipelines_[resolve_info.color_edram_info.msaa_samples !=
+                                           xenos::MsaaSamples::k1X][source_is_uint][raw];
+    pipeline_layout = resolve_image_rt_pipeline_layout_;
+    trials::CountStat(trials::Stat::kResolvesFromRenderTarget);
+  } else {
+    if (!DumpRenderTargets(dump_base, dump_row_length_used, dump_rows, dump_pitch)) {
+      // The texture is still valid; the memory path will invalidate and reload it.
+      return false;
+    }
+    UseEdramBuffer(EdramBufferUsage::kComputeRead);
+    pipeline = raw ? resolve_image_raw_pipeline_ : resolve_image_full_pipeline_;
+    pipeline_layout = resolve_image_pipeline_layout_;
+  }
+
+  command_processor_.BindExternalComputePipeline(pipeline, ExternalComputeRole::kResolveToImage);
+  // Set 0 (the EDRAM buffer) isn't read when reading the render target, but
+  // the layouts are shared.
+  VkDescriptorSet descriptor_sets[] = {
+      edram_storage_buffer_descriptor_set_, target.descriptor_set,
+      source_rt ? source_rt->GetDescriptorSetTransferSource() : VK_NULL_HANDLE};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout, 0,
+                                         source_rt ? 3 : 2, descriptor_sets, 0, nullptr);
+  // The same constants as the resolve to memory, with the texture's endian
+  // swap in the unused bits 28:29 of the destination info.
+  draw_util::ResolveCopyShaderConstants constants = copy_shader_constants;
+  uint32_t dest_info_value;
+  static_assert(sizeof(constants.dest_relative.dest_info) == sizeof(dest_info_value));
+  std::memcpy(&dest_info_value, &constants.dest_relative.dest_info, sizeof(dest_info_value));
+  dest_info_value = (dest_info_value & ~(UINT32_C(3) << 28)) |
+                    (uint32_t(target.texture_endian) << 28);
+  std::memcpy(&constants.dest_relative.dest_info, &dest_info_value, sizeof(dest_info_value));
+  uint32_t constants_size =
+      draw_resolution_scaled ? sizeof(constants.dest_relative) : sizeof(constants);
+  uint32_t push_constants[sizeof(constants) / sizeof(uint32_t) + 2];
+  std::memcpy(push_constants, &constants, constants_size);
+  push_constants[constants_size / sizeof(uint32_t)] = target.dest_y * draw_resolution_scale_y();
+  uint32_t push_constants_size = constants_size + sizeof(uint32_t);
+  if (source_rt) {
+    push_constants[push_constants_size / sizeof(uint32_t)] = source_rt->key().base_tiles;
+    push_constants_size += sizeof(uint32_t);
+  }
+  command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    push_constants_size, push_constants);
+  command_processor_.SubmitBarriers(true);
+  // 8x8 threads of 4 pixels each.
+  uint32_t width = (resolve_info.coordinate_info.width_div_8 << xenos::kResolveAlignmentPixelsLog2) *
+                   draw_resolution_scale_x();
+  uint32_t height = (resolve_info.height_div_8 << xenos::kResolveAlignmentPixelsLog2) *
+                    draw_resolution_scale_y();
+  command_buffer.CmdVkDispatch((width + 31) >> 5, (height + 7) >> 3, 1);
