+VulkanRenderTargetCache::VulkanRenderTarget*
+VulkanRenderTargetCache::GetResolveImageSourceRenderTarget(
+    const draw_util::ResolveInfo& resolve_info, uint32_t dump_base, uint32_t dump_row_length_used,
+    uint32_t dump_rows, uint32_t dump_pitch, bool& source_is_uint) {
+  source_is_uint = false;
+  if (!REXCVAR_GET(vulkan_resolve_from_render_target) ||
+      resolve_image_rt_pipeline_layout_ == VK_NULL_HANDLE) {
+    return nullptr;
+  }
+  const draw_util::ResolveEdramInfo& edram_info = resolve_info.color_edram_info;
+  // The shaders read 1x or 4x render targets of these formats.
+  auto format = xenos::ColorRenderTargetFormat(edram_info.format);
+  if (edram_info.format_is_64bpp || (edram_info.msaa_samples != xenos::MsaaSamples::k1X &&
+                                     edram_info.msaa_samples != xenos::MsaaSamples::k4X)) {
+    return nullptr;
+  }
+  switch (format) {
+    case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10:
+    case xenos::ColorRenderTargetFormat::k_16_16:
+      break;
+    default:
+      return nullptr;
+  }
+  // One render target with the resolve's own format, pitch and MSAA must own
+  // the whole region (otherwise the dump combines several, or leaves parts of
+  // the EDRAM buffer as they were).
+  GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows, dump_pitch,
+                                 dump_rectangles_);
+  if (dump_rectangles_.size() != 1) {
+    return nullptr;
+  }
+  const ResolveCopyDumpRectangle& rectangle = dump_rectangles_.front();
+  if (rectangle.row_first || rectangle.rows != dump_rows || rectangle.row_first_start ||
+      rectangle.row_last_end != dump_row_length_used) {
+    return nullptr;
+  }
+  auto* rt = static_cast<VulkanRenderTarget*>(rectangle.render_target);
+  RenderTargetKey rt_key = rt->key();
+  if (rt_key.is_depth || rt_key.GetColorFormat() != format ||
+      rt_key.msaa_samples != edram_info.msaa_samples ||
+      rt_key.GetPitchTiles() != edram_info.pitch_tiles) {
+    return nullptr;
+  }
+  bool transfer_is_uint;
+  GetColorOwnershipTransferVulkanFormat(format, rt_key.msaa_samples, &transfer_is_uint);
+  // k_16_16 bits only come out exactly through the uint view; the others are
+  // unorm through a float view.
+  if (transfer_is_uint != (format == xenos::ColorRenderTargetFormat::k_16_16)) {
+    return nullptr;
+  }
+  VkPipeline pipeline = resolve_image_rt_pipelines_[edram_info.msaa_samples !=
+                                                    xenos::MsaaSamples::k1X][transfer_is_uint][0];
+  if (pipeline == VK_NULL_HANDLE) {
+    return nullptr;
+  }
+  source_is_uint = transfer_is_uint;
+  return rt;
+}
