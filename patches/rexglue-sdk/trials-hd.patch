+++ b/include/rex/ui/window_web.h
@@ -0,0 +1,57 @@
+/**
+ * @file        ui/window_web.h
+ * @brief       Window of the web (Emscripten) build
+ *
+ * Stands for the page's canvas. The renderer gets the canvas itself (it is
+ * transferred to the GPU worker), so this window has no surface of its own.
+ * Canvas size, focus and input events arrive from the page (W-L08,
+ * docs/web-port/README.md 7.9.5-7.9.6 in Trials HD Recompiled).
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#if !REX_PLATFORM_EMSCRIPTEN
+#error "rex/ui/window_web.h is for the web (Emscripten) build only"
+#endif
+
+#include <array>
+#include <atomic>
+
+#include <rex/ui/window.h>
+
+namespace rex::ui {
+
+class WebWindow : public Window {
+ public:
+  WebWindow(WindowedAppContext& app_context, const std::string_view title,
+            uint32_t desired_logical_width, uint32_t desired_logical_height);
+  ~WebWindow() override;
+
+  // UI thread: dispatches the page's queued input events and canvas size
+  // changes (rex/ui/web.h) to every open web window's listeners.
+  static void PumpPageEvents();
+
+ protected:
+  bool OpenImpl() override;
+  void RequestCloseImpl() override;
+  std::unique_ptr<Surface> CreateSurfaceImpl(Surface::TypeFlags allowed_types) override;
+  void RequestPaintImpl() override;
+  // The page's devicePixelRatio as DPI (96 per 1.0), so overlays keep their
+  // size on HiDPI screens and with browser zoom. Read by the GPU worker too.
+  uint32_t GetLatestDpiImpl() const override { return dpi_.load(std::memory_order_relaxed); }
+
+ private:
+  void PumpPageEventsImpl();
+  void DispatchPageKey(uint32_t scancode, bool down, WindowDestructionReceiver& receiver);
+  void ReleaseHeldKeys(WindowDestructionReceiver& receiver);
+
+  // SDL scancodes held down (for repeats, modifiers and releasing on blur).
+  std::array<bool, 512> keys_down_{};
+  int32_t mouse_x_ = 0;
+  int32_t mouse_y_ = 0;
+  std::atomic<uint32_t> dpi_{96};
+};
+
+}  // namespace rex::ui
diff --git a/include/rex/ui/windowed_app_context_web.h b/include/rex/ui/windowed_app_context_web.h
new file mode 100644
index 0000000..dc2c10a
--- /dev/null
+++ b/include/rex/ui/windowed_app_context_web.h
@@ -0,0 +1,42 @@
+/**
+ * @file        ui/windowed_app_context_web.h
+ * @brief       UI loop of the web (Emscripten) build
+ *
+ * The app's main() runs on a pthread (-sPROXY_TO_PTHREAD), never on the
+ * browser's main thread, so the UI loop is a plain wait for queued functions.
+ * It does not paint: the GPU worker paints (docs/web-port/README.md 7.9.5 in
+ * Trials HD Recompiled).
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#if !REX_PLATFORM_EMSCRIPTEN
+#error "rex/ui/windowed_app_context_web.h is for the web (Emscripten) build only"
+#endif
+
+#include <condition_variable>
+#include <mutex>
+
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex::ui {
+
+class WebWindowedAppContext final : public WindowedAppContext {
+ public:
+  WebWindowedAppContext() = default;
+  ~WebWindowedAppContext() override;
+
+  void NotifyUILoopOfPendingFunctions() override;
+  void PlatformQuitFromUIThread() override;
+
+  int RunMainMessageLoop();
+
+ private:
+  std::mutex wake_mutex_;
+  std::condition_variable wake_;
+  bool wake_pending_ = false;
+};
+
+}  // namespace rex::ui
diff --git a/resources/templates/codegen/pch_h.inja b/resources/templates/codegen/pch_h.inja
index 68274d2..9890fc7 100644
--- a/resources/templates/codegen/pch_h.inja
+++ b/resources/templates/codegen/pch_h.inja
@@ -333,3 +333,101 @@ inline std::atomic<i32>& ppc_global_lock_count_() {
     assert(old_count_ >= 1 && "LeaveGlobalLock called without matching EnterGlobalLock"); \
     rex::thread::global_critical_region::mutex().unlock();                                \
   } while (0)
+
+//=============================================================================
+// Raw-pointer writes
+//=============================================================================
+// At the end of this header so that adding it moved no line above (logging
+// in the inline helpers records __LINE__).
+// Emitted for stvx, stwcx./stdcx. and dcbz/dcbz128.
+#define REX_STORE_V128(x, v) simde_mm_store_si128((simde__m128i*)REX_RAW_ADDR(x), v)
+#define REX_CAS_U32(x, expected, desired) \
+  __sync_bool_compare_and_swap(reinterpret_cast<uint32_t*>(REX_RAW_ADDR(x)), expected, desired)
+#define REX_CAS_U64(x, expected, desired) \
+  __sync_bool_compare_and_swap(reinterpret_cast<uint64_t*>(REX_RAW_ADDR(x)), expected, desired)
+#define REX_ZERO_CACHE_LINE(x, size) memset((void*)REX_RAW_ADDR(x), 0, size)
+// Native FMA stays std::fma; the web path preserves the same double result.
+#define REX_FMA_S(a, b, c) std::fma(a, b, c)
+
+//=============================================================================
+// Web (Emscripten) memory model
+//=============================================================================
+// docs/web-port/README.md 7.9.2-7.9.3: WebAssembly has no page aliasing or
+// page protection, so guest address aliases are folded by a table and every
+// write to guest physical memory marks its page for the GPU, after the write.
+// Native builds never see this block.
+
+#if defined(__EMSCRIPTEN__)
+#include <rex/memory/web_guest.h>
+#include <rex/ppc/web_fma.h>
+#undef REX_FMA_S
+#define REX_FMA_S(a, b, c) ::rex::ppc::FmaSingle(a, b, c)
+
+#undef REX_PHYS_HOST_OFFSET
+#define REX_PHYS_HOST_OFFSET(addr) (::rex::memory::web::kFold[(u32)(addr) >> 24])
+
+// Fold integer offsets first: base + a high guest alias would leave the window.
+#undef REX_RAW_ADDR
+#define REX_RAW_ADDR(x) (base + ((int64_t)(u32)(x) + REX_PHYS_HOST_OFFSET(x)))
+#undef REX_LOAD_U8
+#undef REX_LOAD_U16
+#undef REX_LOAD_U32
+#undef REX_LOAD_U64
+#define REX_LOAD_U8(x) (*(volatile u8*)REX_RAW_ADDR(x))
+#define REX_LOAD_U16(x) __builtin_bswap16(*(volatile u16*)REX_RAW_ADDR(x))
+#define REX_LOAD_U32(x) __builtin_bswap32(*(volatile u32*)REX_RAW_ADDR(x))
+#define REX_LOAD_U64(x) __builtin_bswap64(*(volatile u64*)REX_RAW_ADDR(x))
+
+#undef REX_STORE_U8
+#undef REX_STORE_U16
+#undef REX_STORE_U32
+#undef REX_STORE_U64
+#undef REX_STORE_V128
+#undef REX_CAS_U32
+#undef REX_CAS_U64
+#undef REX_ZERO_CACHE_LINE
+#define REX_STORE_U8(x, y) ::rex::memory::web::Store8(REX_RAW_ADDR(x), (y))
+#define REX_STORE_U16(x, y) ::rex::memory::web::Store16(REX_RAW_ADDR(x), (y))
+#define REX_STORE_U32(x, y) ::rex::memory::web::Store32(REX_RAW_ADDR(x), (y))
+#define REX_STORE_U64(x, y) ::rex::memory::web::Store64(REX_RAW_ADDR(x), (y))
+#define REX_STORE_V128(x, v) ::rex::memory::web::Store128(REX_RAW_ADDR(x), (v))
+#define REX_CAS_U32(x, expected, desired) \
+  ::rex::memory::web::Cas32(REX_RAW_ADDR(x), (expected), (desired))
+#define REX_CAS_U64(x, expected, desired) \
+  ::rex::memory::web::Cas64(REX_RAW_ADDR(x), (expected), (desired))
+#define REX_ZERO_CACHE_LINE(x, size) ::rex::memory::web::Zero(REX_RAW_ADDR(x), (size))
+
+// fctid follows the guest rounding mode (no host rounding control on wasm).
+#define simde_mm_cvtsd_si64(v) ::rex::platform::FPSCRPlatform::CvtsdSi64(v)
+
+#undef REX_MM_STORE_U8
+#undef REX_MM_STORE_U16
+#undef REX_MM_STORE_U32
+#undef REX_MM_STORE_U64
+#define REX_MM_STORE_WEB_(addr, val, store)                                              \
+  do {                                                                                   \
+    u32 _mmio_addr = (addr);                                                             \
+    if (REX_IS_MMIO_ADDR(_mmio_addr)) {                                                  \
+      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr,                \
+                                                              static_cast<u32>(val));    \
+    } else {                                                                             \
+      store(_mmio_addr, val);                                                            \
+    }                                                                                    \
+  } while (0)
+#define REX_MM_STORE_U8(addr, val) REX_MM_STORE_WEB_(addr, val, REX_STORE_U8)
+#define REX_MM_STORE_U16(addr, val) REX_MM_STORE_WEB_(addr, val, REX_STORE_U16)
+#define REX_MM_STORE_U32(addr, val) REX_MM_STORE_WEB_(addr, val, REX_STORE_U32)
+#define REX_MM_STORE_U64(addr, val)                                                      \
+  do {                                                                                   \
+    u32 _mmio_addr = (addr);                                                             \
+    if (REX_IS_MMIO_ADDR(_mmio_addr)) {                                                  \
+      u64 _v64 = static_cast<u64>(val);                                                  \
+      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr,                \
+                                                              static_cast<u32>(_v64 >> 32)); \
+      rex::runtime::MMIOHandler::global_handler()->CheckStore(_mmio_addr + 4,            \
+                                                              static_cast<u32>(_v64));   \
+    } else {                                                                             \
+      REX_STORE_U64(_mmio_addr, val);                                                    \
+    }                                                                                    \
+  } while (0)
+#endif  // __EMSCRIPTEN__
diff --git a/src/audio/web/web_audio_driver.cpp b/src/audio/web/web_audio_driver.cpp
new file mode 100644
index 0000000..216f775
--- /dev/null
+++ b/src/audio/web/web_audio_driver.cpp
@@ -0,0 +1,231 @@
+/**
+ * @file        audio/web/web_audio_driver.cpp
+ * @brief       Audio output of the web (Emscripten) build
+ */
+
+#include <rex/audio/web/web_audio_driver.h>
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <thread>
+
+#include <emscripten/emscripten.h>
+
+#include <rex/audio/conversion.h>
+#include <rex/audio/downmix.h>
+#include <rex/audio/flags.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+// Natively defined by the SDL driver, which the web build does not have.
+REXCVAR_DEFINE_BOOL(audio_mute, false, "Audio", "Mute audio output");
+
+namespace rex::audio::web {
+
+namespace {
+
+alignas(64) WebAudioRing web_audio_ring{};
+
+// Ring fill kept ahead of the worklet: about 43 ms at 48 kHz. With the game's
+// own queue (audio_maxqframes, 8 frames per client) that is about the native
+// SDL latency plus the browser's render quantum.
+constexpr uint32_t kTargetFillFrames = 2048;
+// The worklet counts as stopped when its heartbeat has not moved for this long.
+constexpr auto kConsumerTimeout = std::chrono::milliseconds(150);
+
+constexpr uint32_t kChannelSamples = WebAudioDriver::kChannelSamples;
+static_assert(WebAudioRing::kCapacityFrames % kChannelSamples == 0);
+
+// Mixes the clients into the ring on one thread, which runs while any
+// client exists.
+class Mixer {
+ public:
+  static Mixer& Get() {
+    static Mixer mixer;
+    return mixer;
+  }
+
+  void Add(WebAudioDriver* driver) {
+    std::lock_guard lock(mutex_);
+    drivers_.push_back(driver);
+    if (!thread_.joinable()) {
+      running_ = true;
+      thread_ = std::thread([this] { Run(); });
+    }
+  }
+
+  void Remove(WebAudioDriver* driver) {
+    std::thread thread;
+    {
+      std::lock_guard lock(mutex_);
+      drivers_.erase(std::remove(drivers_.begin(), drivers_.end(), driver), drivers_.end());
+      if (!drivers_.empty()) {
+        return;
+      }
+      running_ = false;
+      thread = std::move(thread_);
+    }
+    wake_.notify_all();
+    if (thread.joinable()) {
+      thread.join();
+    }
+  }
+
+ private:
+  // Mixes one frame of every client that has one queued; writes it to the
+  // ring (silence if no client had one) or drops it.
+  void MixFrame(bool to_ring) {
+    float mix[kChannelSamples * WebAudioRing::kChannels] = {};
+    {
+      std::lock_guard lock(mutex_);
+      for (WebAudioDriver* driver : drivers_) {
+        driver->MixFrame(mix, to_ring);
+      }
+    }
+    if (!to_ring) {
+      return;
+    }
+    WebAudioRing& ring = web_audio_ring;
+    const uint32_t write = ring.write_frame.load(std::memory_order_relaxed);
+    // The capacity is a multiple of the frame size, so a frame never wraps.
+    float* out = &ring.samples[(write % WebAudioRing::kCapacityFrames) * WebAudioRing::kChannels];
+    for (size_t i = 0; i < std::size(mix); ++i) {
+      out[i] = std::clamp(mix[i], -1.0f, 1.0f);
+    }
+    ring.write_frame.store(write + kChannelSamples, std::memory_order_release);
+  }
+
+  void Run() {
+    using clock = std::chrono::steady_clock;
+    constexpr auto kFramePeriod = std::chrono::microseconds(
+        kChannelSamples * 1'000'000 / WebAudioDriver::kFrameRate);
+
+    WebAudioRing& ring = web_audio_ring;
+    uint32_t last_heartbeat = ring.heartbeat.load(std::memory_order_relaxed);
+    clock::time_point last_heartbeat_change = clock::now() - kConsumerTimeout;
+    clock::time_point next_drop = clock::now();
+    bool playing = false;
+
+    for (;;) {
+      {
+        std::lock_guard lock(mutex_);
+        if (!running_) {
+          return;
+        }
+      }
+      const clock::time_point now = clock::now();
+      const uint32_t heartbeat = ring.heartbeat.load(std::memory_order_relaxed);
+      if (heartbeat != last_heartbeat) {
+        last_heartbeat = heartbeat;
+        last_heartbeat_change = now;
+      }
+      const bool consumer = now - last_heartbeat_change < kConsumerTimeout;
+      if (consumer != playing) {
+        playing = consumer;
+        if (playing) {
+          // Start from an empty ring: what was left is stale.
+          ring.write_frame.store(ring.read_frame.load(std::memory_order_acquire),
+                                 std::memory_order_release);
+        }
+        next_drop = now;
+        REXAPU_INFO("web audio: {}", playing ? "playing through the page's AudioWorklet"
+                                             : "not playing (no running AudioContext); "
+                                               "dropping frames at the playback rate");
+      }
+
+      if (playing) {
+        const uint32_t fill = ring.write_frame.load(std::memory_order_relaxed) -
+                              ring.read_frame.load(std::memory_order_acquire);
+        if (fill + kChannelSamples <= kTargetFillFrames) {
+          MixFrame(true);
+          continue;
+        }
+        // The worklet reads 128 frames (2.7 ms) per quantum.
+        std::unique_lock lock(mutex_);
+        wake_.wait_for(lock, std::chrono::milliseconds(1), [this] { return !running_; });
+        continue;
+      }
+      if (now >= next_drop) {
+        MixFrame(false);
+        next_drop = (now - next_drop > kFramePeriod * 4) ? now + kFramePeriod
+                                                         : next_drop + kFramePeriod;
+        continue;
+      }
+      std::unique_lock lock(mutex_);
+      wake_.wait_until(lock, next_drop, [this] { return !running_; });
+    }
+  }
+
+  std::mutex mutex_;
+  std::condition_variable wake_;
+  std::vector<WebAudioDriver*> drivers_;
+  bool running_ = false;
+  std::thread thread_;
+};
+
+}  // namespace
+
+WebAudioRing& GetWebAudioRing() {
+  return web_audio_ring;
+}
+
+// For the page (web/audio.js): where the ring is in the wasm memory.
+extern "C" EMSCRIPTEN_KEEPALIVE uintptr_t rex_web_audio_ring() {
+  WebAudioRing& ring = GetWebAudioRing();
+  ring.capacity_frames = WebAudioRing::kCapacityFrames;
+  ring.sample_rate = WebAudioDriver::kFrameRate;
+  ring.channels = WebAudioRing::kChannels;
+  return reinterpret_cast<uintptr_t>(&ring);
+}
+
+WebAudioDriver::WebAudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+    : AudioDriver(memory), semaphore_(semaphore) {
+  rex_web_audio_ring();
+  Mixer::Get().Add(this);
+}
+
+WebAudioDriver::~WebAudioDriver() {
+  Mixer::Get().Remove(this);
+}
+
+void WebAudioDriver::SubmitFrame(uint32_t frame_ptr) {
+  const float* input = memory_->TranslateVirtual<float*>(frame_ptr);
+  std::lock_guard lock(frames_mutex_);
+  std::vector<float> frame;
+  if (!frames_unused_.empty()) {
+    frame = std::move(frames_unused_.back());
+    frames_unused_.pop_back();
+  }
+  frame.assign(input, input + kFrameSamples);
+  frames_queued_.push_back(std::move(frame));
+}
+
+bool WebAudioDriver::MixFrame(float* mix, bool to_output) {
+  std::vector<float> frame;
+  {
+    std::lock_guard lock(frames_mutex_);
+    if (frames_queued_.empty()) {
+      return false;
+    }
+    frame = std::move(frames_queued_.front());
+    frames_queued_.pop_front();
+  }
+  if (to_output && !REXCVAR_GET(audio_mute)) {
+    float stereo[kChannelSamples * WebAudioRing::kChannels];
+    conversion::sequential_6_BE_to_interleaved_2_LE(stereo, frame.data(), kChannelSamples,
+                                                    GetStereoFold(), GetOutputGain());
+    for (size_t i = 0; i < std::size(stereo); ++i) {
+      mix[i] += stereo[i];
+    }
+  }
+  {
+    std::lock_guard lock(frames_mutex_);
+    frames_unused_.push_back(std::move(frame));
+  }
+  semaphore_->Release(1, nullptr);
+  return true;
+}
+
+}  // namespace rex::audio::web
