diff --git a/include/rex/input/web/web_input_driver.h b/include/rex/input/web/web_input_driver.h
new file mode 100644
index 0000000..2f7e0f3
--- /dev/null
+++ b/include/rex/input/web/web_input_driver.h
@@ -0,0 +1,82 @@
+/**
+ * @file        input/web/web_input_driver.h
+ * @brief       Gamepads in the web (Emscripten) build
+ *
+ * The page polls navigator.getGamepads() (standard mapping) and hands the
+ * state over through shared memory; the app registers a source that reads
+ * it (docs/web-port/README.md 7.9.6 and 8.7 in Trials HD Recompiled).
+ * Keystrokes (XamInputGetKeystroke) are synthesized from button changes as
+ * the SDL driver does.
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#if !REX_PLATFORM_EMSCRIPTEN
+#error "rex/input/web/web_input_driver.h is for the web (Emscripten) build only"
+#endif
+
+#include <array>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::web {
+
+// One gamepad of the page, in the Gamepad API's standard mapping.
+struct WebGamepad {
+  bool connected = false;
+  uint32_t buttons = 0;     // bit i = buttons[i].pressed (0 = A ... 15 = D-pad right, 16 = home)
+  float axes[4] = {};       // left x, left y, right x, right y in -1..1 (+y = down)
+  float triggers[2] = {};   // buttons[6].value, buttons[7].value in 0..1
+};
+
+// Reads gamepad `index` (0..3); false when no consistent copy was available.
+using GamepadSource = std::function<bool(uint32_t index, WebGamepad& out)>;
+
+// Set by the app before the input system is created (CreateDefaultInputSystem
+// adds a WebInputDriver reading it).
+void SetGamepadSource(GamepadSource source);
+const GamepadSource& GetGamepadSource();
+
+class WebInputDriver final : public InputDriver {
+ public:
+  WebInputDriver(rex::ui::Window* window, size_t window_z_order, GamepadSource source);
+  ~WebInputDriver() override;
+
+  X_STATUS Setup() override;
+  void EnumerateDevices(std::vector<DeviceInfo>& out) override;
+  X_RESULT GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) override;
+  X_RESULT GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                 X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                              X_INPUT_KEYSTROKE* out_keystroke) override;
+
+ private:
+  static constexpr uint32_t kMaxPads = 4;
+  enum class RepeatState { kIdle, kWaiting, kRepeating };
+  struct Pad {
+    bool connected = false;
+    bool is_active = false;
+    bool state_changed = false;
+    X_INPUT_STATE state = {};
+    uint64_t keystroke_buttons = 0;
+    RepeatState repeat_state = RepeatState::kIdle;
+    uint8_t repeat_button_index = 0;
+    uint64_t repeat_time = 0;
+  };
+
+  // Reads every pad from the page (caller holds mutex_).
+  void PollLocked();
+  Pad* FindPadLocked(DeviceId id);
