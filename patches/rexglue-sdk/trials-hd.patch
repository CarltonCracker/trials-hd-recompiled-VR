+    return;
+  }
+  // Fully covered whole pixels (all samples), clipped by the scissor.
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor, false);
+  int64_t covered_x0 = std::max(int64_t(std::ceil(x0)), int64_t(scissor.offset[0]));
+  int64_t covered_y0 = std::max(int64_t(std::ceil(y0)), int64_t(scissor.offset[1]));
+  int64_t covered_x1 =
+      std::min(int64_t(std::floor(x1)), int64_t(scissor.offset[0]) + scissor.extent[0]);
+  int64_t covered_y1 =
