+constexpr const char* kFallbackNames[size_t(Fallback::kCount)] = {
+    "upload_gpu_written", "upload_read_changed", "upload_read_unknown", "upload_page_in_order",
+    "g8_format_list_unsupported", "g3_resolve_unsupported", "g3_resolve_no_texture",
