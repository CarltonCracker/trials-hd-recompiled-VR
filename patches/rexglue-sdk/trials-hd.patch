+void VulkanCommandProcessor::StartAsyncSubmit() {
+  if (async_submit_thread_.joinable()) {
+    return;
+  }
+  async_submit_stop_ = false;
+  async_submit_failed_.store(false, std::memory_order_relaxed);
+  async_submit_thread_ = std::thread([this]() { AsyncSubmitThreadMain(); });
+  if (graphics_system_) {
+    async_queue_submitter_presenter_ =
+        static_cast<ui::vulkan::VulkanPresenter*>(graphics_system_->presenter());
+    if (async_queue_submitter_presenter_) {
+      async_queue_submitter_presenter_->SetAsyncQueueSubmitter(this);
+    }
+  }
+}
+
+void VulkanCommandProcessor::StopAsyncSubmit() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  if (async_queue_submitter_presenter_) {
+    // Also waits for consumers currently in AwaitQueueSubmitted.
+    async_queue_submitter_presenter_->SetAsyncQueueSubmitter(nullptr);
+    async_queue_submitter_presenter_ = nullptr;
+  }
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    async_submit_stop_ = true;
+  }
+  async_submit_work_cv_.notify_one();
+  async_submit_thread_.join();
+}
+
+bool VulkanCommandProcessor::HasPendingAsyncSubmissions() {
+  std::lock_guard<std::mutex> lock(async_submit_mutex_);
+  return async_submit_done_ != async_submit_enqueued_;
+}
+
+void VulkanCommandProcessor::AwaitAsyncSubmissions() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  async_submit_done_cv_.wait(lock, [this]() { return async_submit_done_ == async_submit_enqueued_; });
+}
+
+uint64_t VulkanCommandProcessor::EnqueueFenceSignal(VkFence fence) {
+  std::lock_guard<std::mutex> lock(async_submit_mutex_);
+  if (async_submit_done_ == async_submit_enqueued_) {
+    return 0;
+  }
+  AsyncSubmission submission;
+  submission.fence = fence;
+  async_submit_queue_.push_back(std::move(submission));
+  uint64_t ticket = ++async_submit_enqueued_;
+  async_submit_work_cv_.notify_one();
+  return ticket;
+}
+
+void VulkanCommandProcessor::AwaitQueueSubmitted(uint64_t ticket) {
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  async_submit_done_cv_.wait(lock, [this, ticket]() { return async_submit_done_ >= ticket; });
+}
