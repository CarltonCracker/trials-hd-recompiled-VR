diff --git a/include/rex/graphics/trials_fast_path.h b/include/rex/graphics/trials_fast_path.h
new file mode 100644
index 0000000..017f298
--- /dev/null
+++ b/include/rex/graphics/trials_fast_path.h
@@ -0,0 +1,81 @@
+/**
+ * Trials HD fast paths for the Vulkan backend.
+ *
+ * The backend is specialized for Trials HD's workload (docs/vulkan-perf/PLAN.md
+ * in the game repository). Every fast path checks the assumption it relies on
+ * and falls back to the generic code when it does not hold; fallbacks are
+ * counted and reported in the log_guest_fps line, so a game doing something
+ * unexpected shows up as a number instead of a broken frame.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+#include <rex/cvar.h>
+
+REXCVAR_DECLARE(bool, vulkan_trials_fast_path);
+
+namespace rex::graphics::trials {
+
+enum class Fallback : uint32_t {
+  // Shared memory upload not hoisted to the start of the submission (G1):
+  // the GPU wrote the page earlier in the submission.
+  kUploadGpuWritten,
+  // A draw read the page earlier in the submission and the bytes it read
+  // changed since.
+  kUploadReadChanged,
+  // A draw read the page earlier in the submission, before any upload of it in
+  // the submission, so the bytes it read can't be compared.
+  kUploadReadUnknown,
+  // The page was already uploaded in order in this submission.
+  kUploadPageInOrder,
+  // A mutable color target cannot provide a supported view-format list (G8).
+  kRenderTargetFormatListUnsupported,
+  // Resolve not written straight into its texture (G3): a kind of resolve the
+  // direct path doesn't handle (depth, 64bpp, conversions, arrays, read back
+  // by the CPU...).
+  kResolveImageUnsupported,
+  // No texture backs the destination yet (normal for the first frames).
+  kResolveImageNoTexture,
+  // Textures back the destination, but not exactly one directly writable one.
+  kResolveImageTextureMismatch,
+  // The destination texture is outdated (needs a load anyway).
+  kResolveImageTextureOutdated,
+  // A texture loaded memory that a direct resolve didn't write (stale data);
+  // its destination is resolved to memory from then on.
+  kResolveImageStaleLoad,
+  kCount,
+};
+
+// Counters for things that went through a fast path (reported with the
+// fallbacks so their ratio is visible).
+enum class Stat : uint32_t {
+  kUploadPagesHoisted,
+  // Guest occlusion queries begun (each ends the render pass twice today).
+  kOcclusionQueries,
+  // Resolves written straight into their texture (G3).
+  kResolvesToImage,
+  // EndRendering + BeginRendering pairs of the same attachments dropped at replay.
+  kRenderPassesMerged,
+  // Resolves into textures that read their render target instead of a dump.
+  kResolvesFromRenderTarget,
+  kCount,
+};
+
+inline bool Enabled() { return REXCVAR_GET(vulkan_trials_fast_path); }
+
+void CountFallback(Fallback fallback, uint32_t count = 1);
+void CountStat(Stat stat, uint32_t count = 1);
+
+// Non-zero counters since the previous call: stats per frame, exact fallback
+// counts, or an empty string. Resets them.
+std::string TakeReport(uint32_t frames);
+
+}  // namespace rex::graphics::trials
+
+// Evaluates to cond, counting the fallback when it's false.
+#define TRIALS_EXPECT(cond, fallback) \
+  ((cond) ? true : (::rex::graphics::trials::CountFallback(fallback), false))
