+ public:
+  enum Category : uint32_t {
+    kCategoryPassBig,    // render pass with >= 8 draws (scene passes)
+    kCategoryPassSmall,  // render pass with 1..7 draws (transfers, post-process quads)
+    kCategoryPassEmpty,  // render pass without draws (clears only)
+    kCategoryDispatch,
+    kCategoryBarrier,
+    kCategoryCopy,      // buffer -> buffer, buffer -> image, clear image
+    kCategoryTransfer,  // render target ownership transfer passes
+    kCategoryUpload,    // shared memory uploads hoisted to the start of the submission
+    kCategoryOther,
+    kCategoryCount,
+  };
+  static constexpr uint32_t kSlotCount = 16;
+  static constexpr uint32_t kMaxQueriesPerSlot = 8192;
+  static constexpr uint32_t kNoSlot = UINT32_MAX;
+  static constexpr uint32_t kNoQuery = UINT32_MAX;
+  // Distinct pass labels (render target configurations) reported per window;
+  // the last one collects everything past the limit.
+  static constexpr uint32_t kMaxPassLabels = 48;
+
+  // Recorded per submission, added to the report only once its timestamps are read.
+  struct Counters {
+    uint64_t draws = 0;
+    uint64_t image_barriers = 0;
+    uint64_t buffer_barriers = 0;
+    uint64_t passes = 0;
+    // Passes re-opening the previous pass's attachments, by what came in between
+    // (1 = buffer copy, 2 = barrier, 4 = dispatch, 8 = image copy / clear).
+    uint64_t split_passes = 0;
+    uint64_t split_reasons[16] = {};
+    uint64_t pass_draws[4] = {};  // passes with 0, 1-7, 8-63, 64+ draws
+    uint64_t copy_buffer = 0;
+    uint64_t copy_buffer_bytes = 0;
+    uint64_t copy_image = 0;
+    uint64_t truncated = 0;  // boundaries not stamped because the slot was full
+    void Add(const Counters& other) {
+      draws += other.draws;
+      image_barriers += other.image_barriers;
+      buffer_barriers += other.buffer_barriers;
+      passes += other.passes;
+      split_passes += other.split_passes;
+      for (size_t i = 0; i < 16; ++i) {
+        split_reasons[i] += other.split_reasons[i];
+      }
+      for (size_t i = 0; i < 4; ++i) {
+        pass_draws[i] += other.pass_draws[i];
+      }
+      copy_buffer += other.copy_buffer;
+      copy_buffer_bytes += other.copy_buffer_bytes;
+      copy_image += other.copy_image;
+      truncated += other.truncated;
+    }
+  };
+
+  struct Window {
+    double category_ns[kCategoryCount] = {};
+    uint64_t category_count[kCategoryCount] = {};
+    double role_ns[size_t(ExternalComputeRole::kCount)] = {};
+    uint64_t role_count[size_t(ExternalComputeRole::kCount)] = {};
+    double label_ns[kMaxPassLabels] = {};
+    uint64_t label_count[kMaxPassLabels] = {};
+    double total_ns = 0;
+    uint64_t submissions = 0;
+    uint64_t dropped = 0;  // completed, but results unavailable
+    uint64_t skipped = 0;  // not profiled: every slot still in flight
+    Counters counters;
+  };
+
+  // Ticks to nanoseconds and the valid bits of the queue's timestamps.
+  void SetTimestampFormat(double ns_per_tick, uint32_t valid_bits) {
+    ns_per_tick_ = ns_per_tick;
+    timestamp_mask_ = valid_bits >= 64 ? ~uint64_t(0) : (uint64_t(1) << valid_bits) - 1;
+  }
+
+  // Slot lifecycle.
+  uint32_t AcquireSlot() {
+    if (pending_slot_ != kNoSlot) {
+      return pending_slot_;
+    }
+    for (uint32_t i = 0; i < kSlotCount; ++i) {
+      if (!slot_submission_[i]) {
