diff --git a/src/core/memory_emscripten.cpp b/src/core/memory_emscripten.cpp
new file mode 100644
index 0000000..1b4e52f
--- /dev/null
+++ b/src/core/memory_emscripten.cpp
@@ -0,0 +1,250 @@
+/**
+ * @file        core/memory_emscripten.cpp
+ * @brief       Host memory and the guest window for the web (Emscripten) build
+ *
+ * WebAssembly has one linear memory: no reservations, no page protection and
+ * no file mappings to alias pages. Guest memory is a single window that the
+ * heaps fold their aliases onto (rex/memory/web_guest.h); page protection is
+ * bookkeeping kept in the guest page tables, and CPU writes to physical
+ * memory are tracked by the dirty bitmap defined here instead of faults.
+ * See docs/web-port/README.md (Trials HD Recompiled), sections 7.9.2-7.9.3.
+ */
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+
+#include <unistd.h>
+
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/memory/utils.h>
+#include <rex/memory/web_guest.h>
+#include <rex/platform.h>
+
+namespace rex::memory {
+
+namespace web {
+
+std::atomic<uint64_t> g_dirty[kPageCount / 64]{};
+std::atomic<uint64_t> g_dirty_summary[kPageCount / 64 / 64]{};
+uint8_t* g_physical_base = nullptr;
+
+namespace {
+// Guest addresses 0xFFFFF000-0xFFFFFFFF fold to physical 0x20000000 + 0xFFF
+// (the 0xE0000000 view is offset by 4 KiB), as natively, where the backing file
+// is a granule longer than 4.5 GiB. Keep that tail addressable.
+constexpr uint64_t kWindowTail = 0x10000;
+constexpr uint64_t kWindowAlignment = 0x10000;
+
+uint8_t* window_ = nullptr;
+
+bool IsInGuestWindow(const void* p, size_t length) {
+  uintptr_t address = reinterpret_cast<uintptr_t>(p);
+  uintptr_t begin = reinterpret_cast<uintptr_t>(window_);
+  return window_ && address >= begin && length <= kWindowSize + kWindowTail &&
+         address - begin <= kWindowSize + kWindowTail - length;
+}
+}  // namespace
+
+uint8_t* AllocateGuestWindow() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    // sbrk, not malloc: memory past the break has never been written (the
+    // default dlmalloc is built with MORECORE_CANNOT_TRIM, so the break never
+    // moves back), so the window starts zero-filled without touching - and so
+    // committing - any of its pages. malloc keeps working past the window.
+    uintptr_t current = reinterpret_cast<uintptr_t>(sbrk(0));
+    uintptr_t padding = rex::round_up(current, uintptr_t(kWindowAlignment)) - current;
+    void* result = sbrk(intptr_t(padding + kWindowSize + kWindowTail));
+    if (result == reinterpret_cast<void*>(-1)) {
+      REXSYS_ERROR("Unable to reserve the {} MiB guest window in linear memory",
+                   (kWindowSize + kWindowTail) >> 20);
+      return;
+    }
+    window_ = static_cast<uint8_t*>(result) + padding;
+  });
+  return window_;
+}
+
+void MarkGuestWrite(uint32_t guest_address, uint32_t size) {
+  if (!window_) {
+    return;
+  }
+  // Each 16 MiB block folds separately; split at block boundaries.
+  uint64_t address = guest_address;
+  uint64_t end = std::min(uint64_t(guest_address) + size, uint64_t(1) << 32);
+  while (address < end) {
+    uint64_t block_end = std::min(end, (address | 0xFFFFFF) + 1);
+    MarkHostWrite(window_ + (int64_t(address) + kFold[address >> 24]),
+                  uint32_t(block_end - address));
+    address = block_end;
+  }
+}
+
+}  // namespace web
+
+namespace {
+
+// Host allocations (base_address == nullptr): nothing in the SDK makes them
+// today, but keep the contract (zeroed, page-aligned, released whole).
+std::mutex host_allocations_mutex_;
+std::map<uintptr_t, size_t> host_allocations_;
+
+bool FindHostAllocation(const void* p, size_t length, uintptr_t* base_out, size_t* length_out) {
+  uintptr_t address = reinterpret_cast<uintptr_t>(p);
+  std::lock_guard<std::mutex> lock(host_allocations_mutex_);
+  auto it = host_allocations_.upper_bound(address);
+  if (it == host_allocations_.begin()) {
+    return false;
+  }
+  --it;
+  if (address - it->first > it->second || length > it->second - (address - it->first)) {
+    return false;
+  }
+  if (base_out) {
+    *base_out = it->first;
+  }
+  if (length_out) {
+    *length_out = it->second;
+  }
+  return true;
+}
+
+}  // namespace
+
+size_t page_size() {
+  return 4096;
+}
+
+size_t allocation_granularity() {
+  return 4096;
+}
+
+bool IsWritableExecutableMemorySupported() {
+  // Nothing is executable in linear memory.
+  return false;
+}
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type,
+                 PageAccess access) {
+  (void)allocation_type;
+  (void)access;
+  if (!base_address) {
+    size_t rounded = rex::round_up(length, page_size());
+    void* result = std::aligned_alloc(page_size(), rounded);
+    if (!result) {
+      return nullptr;
+    }
+    std::memset(result, 0, rounded);
+    std::lock_guard<std::mutex> lock(host_allocations_mutex_);
+    host_allocations_[reinterpret_cast<uintptr_t>(result)] = rounded;
+    return result;
+  }
+  // The guest window is always readable and writable; the heaps' page tables
+  // hold reservation, commit and protection state.
+  if (web::IsInGuestWindow(base_address, length) ||
+      FindHostAllocation(base_address, length, nullptr, nullptr)) {
+    return base_address;
+  }
+  return nullptr;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  if (web::IsInGuestWindow(base_address, length)) {
+    // As natively, where the views are a shared file mapping, a decommit or
+    // release keeps the contents.
+    return true;
+  }
+  uintptr_t allocation_base;
+  size_t allocation_length;
+  if (!FindHostAllocation(base_address, length, &allocation_base, &allocation_length)) {
+    return false;
+  }
+  switch (deallocation_type) {
+    case DeallocationType::kDecommit:
+      // Anonymous memory reads back as zero once decommitted.
+      std::memset(base_address, 0, length);
+      return true;
+    case DeallocationType::kRelease: {
+      if (allocation_base != reinterpret_cast<uintptr_t>(base_address)) {
+        return false;
+      }
+      {
+        std::lock_guard<std::mutex> lock(host_allocations_mutex_);
+        host_allocations_.erase(allocation_base);
+      }
+      std::free(base_address);
+      return true;
+    }
+    default:
+      assert_always();
+      return false;
+  }
+}
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  (void)access;
+  if (out_old_access) {
+    *out_old_access = PageAccess::kReadWrite;
+  }
+  return web::IsInGuestWindow(base_address, length) ||
+         FindHostAllocation(base_address, length, nullptr, nullptr);
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  access_out = PageAccess::kNoAccess;
+  length = 0;
+  uintptr_t address = reinterpret_cast<uintptr_t>(base_address);
+  if (web::IsInGuestWindow(base_address, 1)) {
+    length = reinterpret_cast<uintptr_t>(web::window_) + web::kWindowSize + web::kWindowTail -
+             address;
+    access_out = PageAccess::kReadWrite;
+    return true;
+  }
+  uintptr_t allocation_base;
+  size_t allocation_length;
+  if (FindHostAllocation(base_address, 1, &allocation_base, &allocation_length)) {
+    length = allocation_base + allocation_length - address;
+    access_out = PageAccess::kReadWrite;
+    return true;
+  }
+  return false;
+}
+
+// No shared file mappings in a browser: Memory uses the guest window instead.
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length,
+                                          PageAccess access, bool commit) {
+  (void)path;
+  (void)length;
+  (void)access;
+  (void)commit;
+  return kFileMappingHandleInvalid;
+}
+
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+  (void)handle;
+  (void)path;
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  (void)handle;
+  (void)base_address;
+  (void)length;
+  (void)access;
+  (void)file_offset;
+  return nullptr;
+}
+
+bool UnmapFileView(FileMappingHandle handle, void* base_address, size_t length) {
+  (void)handle;
+  (void)base_address;
+  (void)length;
+  return false;
+}
+
+}  // namespace rex::memory
