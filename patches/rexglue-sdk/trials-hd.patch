+        return i;
+      }
+    }
+    ++window_.skipped;
+    return kNoSlot;
+  }
+  void ReleasePendingSlot() { pending_slot_ = kNoSlot; }
+  // The pending slot was submitted as `submission` (nonzero).
+  void SlotSubmitted(uint64_t submission) {
+    if (pending_slot_ == kNoSlot) {
+      return;
+    }
+    assert_not_zero(submission);
+    slot_submission_[pending_slot_] = submission;
+    pending_slot_ = kNoSlot;
+  }
+  bool AnySlotInFlight() const {
+    for (uint64_t submission : slot_submission_) {
+      if (submission) {
+        return true;
+      }
+    }
+    return false;
+  }
+  bool IsSlotFree(uint32_t slot) const {
+    return slot != pending_slot_ && !slot_submission_[slot];
+  }
+  // Frees in-flight slots whose submission has completed, oldest first, calling
+  // harvest(slot) before each is freed.
+  template <typename Harvest>
+  void RetireCompleted(uint64_t completed_submission, Harvest&& harvest) {
+    for (;;) {
+      uint32_t oldest = kNoSlot;
+      for (uint32_t i = 0; i < kSlotCount; ++i) {
+        if (slot_submission_[i] && slot_submission_[i] <= completed_submission &&
+            (oldest == kNoSlot || slot_submission_[i] < slot_submission_[oldest])) {
+          oldest = i;
+        }
+      }
+      if (oldest == kNoSlot) {
+        return;
+      }
+      harvest(oldest);
+      slot_submission_[oldest] = 0;
+    }
+  }
+
+  // Recording into the pending slot; tags_ must hold kMaxQueriesPerSlot entries.
+  void BeginRecording(uint32_t slot, uint32_t* tags) {
+    recording_slot_ = slot;
+    recording_tags_ = tags;
+    recording_query_ = 0;
+    slot_counters_[slot] = Counters();
+    in_pass_ = false;
+    pass_query_ = kNoQuery;
+    pass_draws_ = 0;
+    previous_pass_key_ = 0;
+    between_mask_ = 0;
+    compute_role_ = ExternalComputeRole::kOther;
+  }
+  // Returns the query to write a timestamp to for an interval with `tag`, or kNoQuery.
+  // The last query is reserved for EndRecording.
+  uint32_t Mark(uint32_t tag) {
+    if (recording_query_ >= kMaxQueriesPerSlot - 1) {
+      ++slot_counters_[recording_slot_].truncated;
+      return kNoQuery;
+    }
+    recording_tags_[recording_query_] = tag;
+    return recording_query_++;
+  }
+  uint32_t EndRecording() {
+    assert_true(recording_query_ < kMaxQueriesPerSlot);
+    recording_tags_[recording_query_] = kCategoryOther;
+    uint32_t query = recording_query_++;
+    slot_query_count_[recording_slot_] = recording_query_;
+    return query;
+  }
+  // label: what the pass renders to, for the per-target breakdown (0 if unknown).
+  uint32_t MarkPassBegin(uint64_t attachments_key, bool is_transfer = false, uint64_t label = 0) {
+    Counters& counters = slot_counters_[recording_slot_];
+    ++counters.passes;
+    if (attachments_key && attachments_key == previous_pass_key_) {
+      ++counters.split_passes;
+      ++counters.split_reasons[between_mask_ & 15];
+    }
+    previous_pass_key_ = attachments_key;
+    between_mask_ = 0;
+    in_pass_ = true;
+    pass_is_transfer_ = is_transfer;
+    pass_label_index_ = PassLabelIndex(label);
+    pass_draws_ = 0;
+    pass_query_ = Mark(kCategoryPassEmpty);
+    return pass_query_;
+  }
+  void MarkPassEnd() {
+    if (!in_pass_) {
+      return;
+    }
+    in_pass_ = false;
+    if (pass_query_ != kNoQuery) {
+      recording_tags_[pass_query_] = (pass_is_transfer_    ? kCategoryTransfer
+                                      : pass_draws_ >= 8 ? kCategoryPassBig
+                                      : pass_draws_      ? kCategoryPassSmall
+                                                         : kCategoryPassEmpty) |
+                                     (pass_label_index_ << 16);
+    }
+    pass_query_ = kNoQuery;
+    ++slot_counters_[recording_slot_]
