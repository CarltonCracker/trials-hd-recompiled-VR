+          }
+          if (relative_end > covered_end_tiles) {
+            Transfer& tail = kept.emplace_back(transfer);
+            tail.start_tiles = transfer.start_tiles + (covered_end_tiles - relative_start);
+          }
+          continue;
+        }
+      }
+      kept.push_back(transfer);
+    }
+    transfers = std::move(kept);
+  }
