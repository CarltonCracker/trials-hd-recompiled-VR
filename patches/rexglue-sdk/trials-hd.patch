+bool VulkanTextureCache::IsResolveImageCandidate(TextureKey key) const {
+  if (!trials::Enabled() || key.dimension != xenos::DataDimension::k2DOrStacked ||
+      key.depth_or_array_size_minus_1 || key.mip_max_level || key.packed_mips || !key.tiled) {
+    return false;
+  }
+  // Only textures that the copy loader fills with the guest words as they are.
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  bool host_format_is_signed;
+  if (IsSignedVersionSeparateForFormat(key)) {
+    host_format_is_signed = bool(key.signed_separate);
+  } else {
+    host_format_is_signed = host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  }
+  const HostFormat& host_format =
+      host_format_is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned;
+  if (host_format.load_shader != kLoadShaderIndex32bpb) {
+    return false;
+  }
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  return format_info->block_width == 1 && format_info->block_height == 1 &&
+         format_info->bits_per_pixel == 32;
+}
