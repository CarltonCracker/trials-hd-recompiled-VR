+/**
+ * @file        core/exception_handler_emscripten.cpp
+ * @brief       Exception handler for the web (Emscripten) build: none
+ *
+ * WebAssembly has no signals or page protection, so nothing ever faults into
+ * a handler. MMIO goes through the recompiler's REX_MM_* macros and write
+ * watches through the dirty bitmap (Memory::DeliverPhysicalWrites).
+ * See docs/web-port/README.md (Trials HD Recompiled), section 7.9.4.
+ */
+
+#include <rex/exception_handler.h>
+
+namespace rex::arch {
+
+void ExceptionHandler::Install(Handler fn, void* data) {
+  (void)fn;
+  (void)data;
+}
+
+void ExceptionHandler::Uninstall(Handler fn, void* data) {
+  (void)fn;
+  (void)data;
+}
+
+}  // namespace rex::arch
diff --git a/src/core/fiber_emscripten.cpp b/src/core/fiber_emscripten.cpp
new file mode 100644
index 0000000..7c97e80
--- /dev/null
+++ b/src/core/fiber_emscripten.cpp
@@ -0,0 +1,52 @@
+/**
+ * @file        core/fiber_emscripten.cpp
+ * @brief       Fibers in the web (Emscripten) build: the thread's own only
+ *
+ * WebAssembly cannot switch stacks without Asyncify instrumenting every
+ * function on them, which the recompiled code cannot afford. Every guest
+ * thread converts itself to a fiber (XThread::Execute), so that works;
+ * creating or switching to another fiber is fatal. W-S08 checks that Trials
+ * HD never does (docs/web-port/README.md 7.9.1 and 14.5 in Trials HD
+ * Recompiled).
+ */
+
+#include <cstdlib>
+
+#include <rex/logging.h>
+#include <rex/thread/fiber.h>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  (void)stack_size;
+  (void)entry;
+  (void)arg;
+  REXSYS_CRITICAL("Guest fibers are not supported on the web (CreateFiber)");
+  rex::FlushLogging();
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  (void)target;
+  REXSYS_CRITICAL("Guest fibers are not supported on the web (SwitchToFiber)");
+  rex::FlushLogging();
+  std::abort();
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_ && tls_current_ == this) {
+    tls_current_ = nullptr;
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
