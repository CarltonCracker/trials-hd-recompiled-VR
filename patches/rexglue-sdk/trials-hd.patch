+  float x0 = FLT_MAX, y0 = FLT_MAX, x1 = -FLT_MAX, y1 = -FLT_MAX;
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionExportSink export_sink;
+  shader_interpreter_.SetExportSink(&export_sink);
+  bool valid = true;
+  for (uint32_t i = 0; i < 3 && valid; ++i) {
+    uint32_t vertex_index = std::min(max_index, std::max(min_index, (i + index_offset) & 0xFFFFFF));
+    export_sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if ((export_sink.vertex_kill().has_value() &&
+         (export_sink.vertex_kill().value() & ~(UINT32_C(1) << 31))) ||
+        !export_sink.position_x().has_value() || !export_sink.position_y().has_value()) {
+      valid = false;
+      break;
+    }
+    float x = export_sink.position_x().value();
+    float y = export_sink.position_y().value();
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      if (!export_sink.position_w().has_value() || !(export_sink.position_w().value() > 0.0f)) {
+        valid = false;
+        break;
+      }
+      x /= export_sink.position_w().value();
+      y /= export_sink.position_w().value();
+    }
+    x = x * viewport_x_scale + viewport_x_offset + pixel_offset + window_x_offset;
+    y = y * viewport_y_scale + viewport_y_offset + pixel_offset + window_y_offset;
+    if (!std::isfinite(x) || !std::isfinite(y)) {
+      valid = false;
+      break;
+    }
+    x0 = std::min(x0, x);
+    y0 = std::min(y0, y);
+    x1 = std::max(x1, x);
+    y1 = std::max(y1, y);
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (!valid) {
+    return false;
+  }
+  x0_out = x0;
+  y0_out = y0;
+  x1_out = x1;
+  y1_out = y1;
+  return true;
+}
