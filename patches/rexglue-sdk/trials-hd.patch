diff --git a/src/ui/web/web_ui.cpp b/src/ui/web/web_ui.cpp
new file mode 100644
index 0000000..ea51e07
--- /dev/null
+++ b/src/ui/web/web_ui.cpp
@@ -0,0 +1,75 @@
+/**
+ * @file        ui/web/web_ui.cpp
+ * @brief       Page input source, canvas state and UI-thread lock of the web build
+ */
+
+#include <rex/ui/web.h>
+
+#include <rex/ui/immediate_drawer.h>
+
+namespace rex::ui::web {
+
+namespace {
+
+InputSource input_source;
+
+std::mutex presenter_ready_mutex;
+PresenterReadyHandler presenter_ready_handler = nullptr;
+void* presenter_ready_context = nullptr;
+// A presenter that became ready before the app registered its handler.
+Presenter* pending_presenter = nullptr;
+std::unique_ptr<ImmediateDrawer> pending_drawer;
+
+}  // namespace
+
+void SetInputSource(const InputSource& source) {
+  input_source = source;
+}
+
+const InputSource& GetInputSource() {
+  return input_source;
+}
+
+bool GetCanvasState(CanvasState& out) {
+  return input_source.get_canvas_state && input_source.get_canvas_state(out);
+}
+
+std::recursive_mutex& UIMutex() {
+  static std::recursive_mutex mutex;
+  return mutex;
+}
+
+void SetPresenterReadyHandler(PresenterReadyHandler handler, void* context) {
+  Presenter* presenter;
+  std::unique_ptr<ImmediateDrawer> drawer;
+  {
+    std::lock_guard lock(presenter_ready_mutex);
+    presenter_ready_handler = handler;
+    presenter_ready_context = context;
+    if (!handler || !pending_presenter) {
+      return;
+    }
+    presenter = pending_presenter;
+    drawer = std::move(pending_drawer);
+    pending_presenter = nullptr;
+  }
+  handler(context, presenter, std::move(drawer));
+}
+
+void NotifyPresenterReady(Presenter* presenter, std::unique_ptr<ImmediateDrawer> drawer) {
+  PresenterReadyHandler handler;
+  void* context;
+  {
+    std::lock_guard lock(presenter_ready_mutex);
+    handler = presenter_ready_handler;
+    context = presenter_ready_context;
+    if (!handler) {
+      pending_presenter = presenter;
+      pending_drawer = std::move(drawer);
+      return;
+    }
+  }
+  handler(context, presenter, std::move(drawer));
+}
+
+}  // namespace rex::ui::web
diff --git a/src/ui/web/window_web.cpp b/src/ui/web/window_web.cpp
new file mode 100644
index 0000000..b7a5fd4
--- /dev/null
+++ b/src/ui/web/window_web.cpp
@@ -0,0 +1,250 @@
+/**
+ * @file        ui/web/window_web.cpp
+ * @brief       Window of the web (Emscripten) build
+ */
+
+#include <rex/ui/window_web.h>
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include <SDL3/SDL_scancode.h>
+
+#include <rex/ui/sdl_virtual_key.h>
+#include <rex/ui/surface.h>
+#include <rex/ui/web.h>
+
+namespace rex::ui {
+
+namespace {
+
+// Open web windows (UI thread only).
+std::vector<WebWindow*> web_windows;
+
+uint32_t DpiFromPixelRatio(float device_pixel_ratio) {
+  if (!(device_pixel_ratio > 0.0f)) {
+    return 96;
+  }
+  return uint32_t(std::clamp(std::lround(96.0f * device_pixel_ratio), 48l, 768l));
+}
+
+MouseEvent::Button TranslatePageMouseButton(uint32_t button) {
+  switch (button) {
+    case 1:
+      return MouseEvent::Button::kLeft;
+    case 2:
+      return MouseEvent::Button::kMiddle;
+    case 3:
+      return MouseEvent::Button::kRight;
+    case 4:
+      return MouseEvent::Button::kX1;
+    case 5:
+      return MouseEvent::Button::kX2;
+    default:
+      return MouseEvent::Button::kNone;
+  }
+}
+
+}  // namespace
+
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                       const std::string_view title, uint32_t desired_logical_width,
+                                       uint32_t desired_logical_height) {
+  return std::make_unique<WebWindow>(app_context, title, desired_logical_width,
+                                     desired_logical_height);
+}
+
+WebWindow::WebWindow(WindowedAppContext& app_context, const std::string_view title,
+                     uint32_t desired_logical_width, uint32_t desired_logical_height)
+    : Window(app_context, title, desired_logical_width, desired_logical_height) {
+  web_windows.push_back(this);
+}
+
+WebWindow::~WebWindow() {
+  web_windows.erase(std::remove(web_windows.begin(), web_windows.end(), this), web_windows.end());
+  EnterDestructor();
+}
+
+void WebWindow::PumpPageEvents() {
+  // A listener may close a window; iterate over a copy.
+  std::vector<WebWindow*> windows = web_windows;
+  for (WebWindow* window : windows) {
+    if (std::find(web_windows.begin(), web_windows.end(), window) != web_windows.end()) {
+      window->PumpPageEventsImpl();
+    }
+  }
+}
+
+void WebWindow::PumpPageEventsImpl() {
+  if (phase() != Phase::kOpen) {
+    return;
+  }
+  WindowDestructionReceiver receiver(this);
+
+  web::CanvasState canvas;
+  if (web::GetCanvasState(canvas) && canvas.width && canvas.height) {
+    uint32_t dpi = DpiFromPixelRatio(canvas.device_pixel_ratio);
+    if (dpi != dpi_.load(std::memory_order_relaxed)) {
+      dpi_.store(dpi, std::memory_order_relaxed);
+      UISetupEvent e(this);
+      OnDpiChanged(e, receiver);
+      if (receiver.IsWindowDestroyed()) {
+        return;
+      }
+    }
+    if (canvas.width != GetActualPhysicalWidth() || canvas.height != GetActualPhysicalHeight()) {
+      OnActualSizeUpdate(canvas.width, canvas.height, receiver);
+      if (receiver.IsWindowDestroyed()) {
+        return;
+      }
+    }
+  }
+
+  const web::InputSource& source = web::GetInputSource();
+  if (!source.drain_events) {
+    return;
+  }
+  web::InputEvent events[64];
+  for (;;) {
+    size_t count = source.drain_events(events, std::size(events));
+    for (size_t i = 0; i < count; ++i) {
+      const web::InputEvent& event = events[i];
+      switch (event.type) {
+        case web::kKeyDown:
+        case web::kKeyUp:
+          DispatchPageKey(event.code, event.type == web::kKeyDown, receiver);
+          break;
+        case web::kText: {
+          KeyEvent e(this, VirtualKey(event.code), 1, false, false, false, false, false);
+          OnKeyChar(e, receiver);
+          break;
+        }
+        case web::kPointerMove: {
+          MouseEvent e(this, MouseEvent::Button::kNone, event.x, event.y, 0, 0,
+                       float(event.x - mouse_x_), float(event.y - mouse_y_));
+          mouse_x_ = event.x;
+          mouse_y_ = event.y;
+          OnMouseMove(e, receiver);
+          break;
+        }
+        case web::kPointerDown:
+        case web::kPointerUp: {
+          mouse_x_ = event.x;
+          mouse_y_ = event.y;
+          MouseEvent e(this, TranslatePageMouseButton(event.code), event.x, event.y);
+          if (event.type == web::kPointerDown) {
+            OnMouseDown(e, receiver);
+          } else {
+            OnMouseUp(e, receiver);
+          }
+          break;
+        }
+        case web::kWheel: {
+          // DOM deltas are pixels, about 100 per notch, positive y downwards;
+          // listeners expect 120 per detent, positive y upwards (as SDL).
+          MouseEvent e(this, MouseEvent::Button::kNone, mouse_x_, mouse_y_,
+                       int32_t(event.x * int32_t(MouseEvent::kScrollPerDetent) / 100),
+                       int32_t(-event.y * int32_t(MouseEvent::kScrollPerDetent) / 100));
+          OnMouseWheel(e, receiver);
+          break;
+        }
+        case web::kFocus:
+          OnFocusUpdate(true, receiver);
+          break;
+        case web::kBlur:
+          // Keys released while the page had no focus never arrive.
+          ReleaseHeldKeys(receiver);
+          if (!receiver.IsWindowDestroyed()) {
+            OnFocusUpdate(false, receiver);
+          }
+          break;
+        default:
+          break;
+      }
+      if (receiver.IsWindowDestroyed()) {
+        return;
+      }
+    }
+    if (count < std::size(events)) {
+      return;
+    }
+  }
+}
+
+void WebWindow::DispatchPageKey(uint32_t scancode, bool down,
+                                WindowDestructionReceiver& receiver) {
+  if (scancode == 0 || scancode >= keys_down_.size()) {
+    return;
+  }
+  bool was_down = keys_down_[scancode];
+  keys_down_[scancode] = down;
+  if (!down && !was_down) {
+    return;
+  }
+  VirtualKey virtual_key = TranslateSDLScancode(SDL_Scancode(scancode));
+  if (virtual_key == VirtualKey::kNone) {
+    return;
+  }
+  auto held = [this](SDL_Scancode left, SDL_Scancode right) {
+    return keys_down_[left] || keys_down_[right];
+  };
+  KeyEvent e(this, virtual_key, /*repeat_count=*/1, /*prev_state=*/was_down,
+             held(SDL_SCANCODE_LSHIFT, SDL_SCANCODE_RSHIFT),
+             held(SDL_SCANCODE_LCTRL, SDL_SCANCODE_RCTRL),
+             held(SDL_SCANCODE_LALT, SDL_SCANCODE_RALT),
+             held(SDL_SCANCODE_LGUI, SDL_SCANCODE_RGUI));
+  if (down) {
+    OnKeyDown(e, receiver);
+  } else {
+    OnKeyUp(e, receiver);
+  }
+}
+
+void WebWindow::ReleaseHeldKeys(WindowDestructionReceiver& receiver) {
+  for (uint32_t scancode = 0; scancode < keys_down_.size(); ++scancode) {
+    if (keys_down_[scancode]) {
+      DispatchPageKey(scancode, false, receiver);
+      if (receiver.IsWindowDestroyed()) {
+        return;
+      }
+    }
+  }
+}
+
+bool WebWindow::OpenImpl() {
+  // The page's canvas size when known (it arrives later otherwise, through
+  // PumpPageEvents), else the desired size.
+  WindowDestructionReceiver destruction_receiver(this);
+  web::CanvasState canvas;
+  if (web::GetCanvasState(canvas) && canvas.width && canvas.height) {
+    dpi_.store(DpiFromPixelRatio(canvas.device_pixel_ratio), std::memory_order_relaxed);
+    OnActualSizeUpdate(canvas.width, canvas.height, destruction_receiver);
+  } else {
+    OnActualSizeUpdate(SizeToPhysical(GetDesiredLogicalWidth()),
+                       SizeToPhysical(GetDesiredLogicalHeight()), destruction_receiver);
+  }
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return true;
+  }
+  OnFocusUpdate(true, destruction_receiver);
+  return true;
+}
+
+void WebWindow::RequestCloseImpl() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+  OnAfterClose();
+}
+
+std::unique_ptr<Surface> WebWindow::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  (void)allowed_types;
+  return nullptr;
+}
+
+void WebWindow::RequestPaintImpl() {}
+
+}  // namespace rex::ui
