+  // Split into runs of pages that can be uploaded at the start of the
+  // submission and runs that must stay in submission order.
+  upload_ranges_hoisted_.clear();
+  upload_ranges_in_order_.clear();
+  for (const std::pair<uint32_t, uint32_t>& range : upload_page_ranges) {
+    for (uint32_t page = range.first; page < range.first + range.second; ++page) {
+      std::vector<std::pair<uint32_t, uint32_t>>& runs =
+          CanHoistPageUpload(page) ? upload_ranges_hoisted_ : upload_ranges_in_order_;
+      if (!runs.empty() && runs.back().first + runs.back().second == page) {
+        ++runs.back().second;
+      } else {
+        runs.emplace_back(page, 1);
+      }
+    }
+  }
+  bool successful = UploadRangesHoisted(upload_ranges_hoisted_);
+  if (!upload_ranges_in_order_.empty()) {
+    for (const std::pair<uint32_t, uint32_t>& range : upload_ranges_in_order_) {
+      SetPageBits(page_uploaded_in_order_bits_, range.first, range.second);
+    }
+    successful = UploadRangesInOrder(upload_ranges_in_order_) && successful;
+  }
+  return successful;
+}
+
+bool VulkanSharedMemory::CanHoistPageUpload(uint32_t page) {
+  if (GetPageBit(page_uploaded_in_order_bits_, page)) {
+    trials::CountFallback(trials::Fallback::kUploadPageInOrder);
+    return false;
+  }
+  if (any_page_gpu_written_ && GetPageBit(page_gpu_written_bits_, page)) {
+    // The CPU data must land after the GPU's write.
+    trials::CountFallback(trials::Fallback::kUploadGpuWritten);
+    return false;
+  }
+  uint32_t read_end = page_read_end_[page];
+  if (!read_end) {
+    return true;
+  }
+  // A draw earlier in the submission may have read the page. Moving this upload
+  // before it is fine only if the bytes it could read are the same in the new
+  // data (the Direct3D runtime appends to its dynamic buffers, so usually only
+  // the unread rest of a page changes).
+  const uint8_t* previous = page_latest_upload_[page];
+  if (!previous) {
+    trials::CountFallback(trials::Fallback::kUploadReadUnknown);
+    return false;
+  }
+  uint32_t read_start = page_read_start_[page];
+  const uint8_t* current =
+      memory().TranslatePhysical<const uint8_t*>(page << page_size_log2()) + read_start;
+  if (std::memcmp(current, previous + read_start, read_end - read_start)) {
+    trials::CountFallback(trials::Fallback::kUploadReadChanged);
+    return false;
+  }
+  return true;
+}
+
+void VulkanSharedMemory::SetPageBits(std::vector<uint64_t>& bits, uint32_t page_first,
+                                     uint32_t page_count) {
+  uint32_t page_end = page_first + page_count;
+  for (uint32_t page = page_first; page < page_end;) {
+    uint32_t bit = page & 63;
+    uint32_t bits_in_word = std::min(64 - bit, page_end - page);
+    uint64_t mask = bits_in_word == 64 ? ~uint64_t(0) : ((uint64_t(1) << bits_in_word) - 1) << bit;
+    bits[page >> 6] |= mask;
+    page += bits_in_word;
+  }
+}
+
+void VulkanSharedMemory::OnRangesRequested(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  if (!trials::Enabled()) {
+    return;
+  }
+  // The GPU may read these bytes from now on in this submission.
+  uint32_t page_size = uint32_t(1) << page_size_log2();
+  for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+    uint32_t start = range.first;
+    uint32_t end = range.first + range.second;
+    uint32_t page_first = start >> page_size_log2();
+    uint32_t page_last = (end - 1) >> page_size_log2();
+    for (uint32_t page = page_first; page <= page_last; ++page) {
+      uint32_t page_start = page << page_size_log2();
+      uint32_t read_start = page == page_first ? start - page_start : 0;
+      uint32_t read_end = page == page_last ? end - page_start : page_size;
+      if (!page_touched_[page]) {
+        page_touched_[page] = 1;
+        pages_touched_.push_back(page);
+      }
+      if (page_read_end_[page]) {
+        page_read_start_[page] = std::min(page_read_start_[page], read_start);
+        page_read_end_[page] = std::max(page_read_end_[page], read_end);
+      } else {
+        page_read_start_[page] = read_start;
+        page_read_end_[page] = read_end;
+      }
+    }
+  }
+}
+
+void VulkanSharedMemory::OnRangeWrittenByGpu(uint32_t start, uint32_t length) {
+  if (!length || !trials::Enabled()) {
+    return;
+  }
+  uint32_t page_first = start >> page_size_log2();
+  uint32_t page_last = (start + length - 1) >> page_size_log2();
+  SetPageBits(page_gpu_written_bits_, page_first, page_last - page_first + 1);
+  any_page_gpu_written_ = true;
+}
+
+bool VulkanSharedMemory::UploadRangesHoisted(
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) {
+  uint64_t submission_current = command_processor_.GetCurrentSubmission();
+  for (auto upload_range : upload_page_ranges) {
+    uint32_t upload_range_start = upload_range.first;
+    uint32_t upload_range_length = upload_range.second;
+    while (upload_range_length) {
+      VkBuffer upload_buffer;
+      VkDeviceSize upload_buffer_offset, upload_buffer_size;
+      uint8_t* upload_buffer_mapping = upload_buffer_pool_->RequestPartial(
+          submission_current, upload_range_length << page_size_log2(),
+          size_t(1) << page_size_log2(), upload_buffer, upload_buffer_offset, upload_buffer_size);
+      if (upload_buffer_mapping == nullptr) {
+        REXGPU_ERROR("Shared memory: Failed to get a Vulkan upload buffer");
+        return false;
+      }
+      MakeRangeValid(upload_range_start << page_size_log2(), uint32_t(upload_buffer_size), false);
+      std::memcpy(upload_buffer_mapping,
+                  memory().TranslatePhysical(upload_range_start << page_size_log2()),
+                  upload_buffer_size);
+      HoistedCopy& copy = hoisted_copies_.emplace_back();
+      copy.source = upload_buffer;
+      copy.region.srcOffset = upload_buffer_offset;
+      copy.region.dstOffset = VkDeviceSize(upload_range_start << page_size_log2());
+      copy.region.size = upload_buffer_size;
+      uint32_t upload_buffer_pages = uint32_t(upload_buffer_size >> page_size_log2());
+      // Reads from here on see this data.
+      for (uint32_t i = 0; i < upload_buffer_pages; ++i) {
+        uint32_t page = upload_range_start + i;
+        if (!page_touched_[page]) {
+          page_touched_[page] = 1;
+          pages_touched_.push_back(page);
+        }
+        page_read_end_[page] = 0;
+        page_latest_upload_[page] = upload_buffer_mapping + (size_t(i) << page_size_log2());
+      }
+      trials::CountStat(trials::Stat::kUploadPagesHoisted, upload_buffer_pages);
+      upload_range_start += upload_buffer_pages;
+      upload_range_length -= upload_buffer_pages;
+    }
+  }
+  return true;
+}
+
+void VulkanSharedMemory::TakeHoistedUploads(std::vector<HoistedCopy>& copies_out) {
+  copies_out.swap(hoisted_copies_);
+  hoisted_copies_.clear();
+  // Reset the per-submission tracking.
+  for (uint32_t page : pages_touched_) {
+    page_touched_[page] = 0;
+    page_read_end_[page] = 0;
+    page_latest_upload_[page] = nullptr;
+  }
+  pages_touched_.clear();
+  if (any_page_gpu_written_) {
+    std::fill(page_gpu_written_bits_.begin(), page_gpu_written_bits_.end(), 0);
+    any_page_gpu_written_ = false;
+  }
+  std::fill(page_uploaded_in_order_bits_.begin(), page_uploaded_in_order_bits_.end(), 0);
+}
+
+void VulkanSharedMemory::RecordHoistedUploads(VkCommandBuffer command_buffer,
+                                              const std::vector<HoistedCopy>& copies,
+                                              std::vector<VkBufferCopy>& regions_temp) const {
+  if (copies.empty()) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn =
+      command_processor_.GetVulkanDevice()->functions();
+  // Earlier submissions may still read or write the destination ranges.
+  VkMemoryBarrier barrier;
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.pNext = nullptr;
+  barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+  // Group the regions by upload buffer (they're in allocation order, so
+  // consecutive copies usually share it).
+  size_t i = 0;
+  while (i < copies.size()) {
+    VkBuffer source = copies[i].source;
+    regions_temp.clear();
+    for (; i < copies.size() && copies[i].source == source; ++i) {
+      regions_temp.push_back(copies[i].region);
+    }
+    dfn.vkCmdCopyBuffer(command_buffer, source, buffer_, uint32_t(regions_temp.size()),
+                        regions_temp.data());
+  }
+  regions_temp.clear();
+  barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &barrier, 0, nullptr, 0,
+                           nullptr);
+}
