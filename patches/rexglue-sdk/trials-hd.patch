+void VulkanGpuProfiler::Report(uint64_t now_ns, uint64_t frame) {
+  static constexpr const char* kCategoryNames[kCategoryCount] = {
+      "rp_big", "rp_small", "rp_clear", "dispatch", "barrier",
+      "copy",   "transfer", "upload",   "other"};
+  static constexpr const char* kRoleNames[size_t(ExternalComputeRole::kCount)] = {
+      "other",           "resolve_copy", "resolve_clear", "resolve_dump", "resolve_readback",
+      "host_depth_store", "texture_load", "memexport",     "swap",          "resolve_to_image"};
+  const Window& w = window_;
+  const Counters& c = w.counters;
+  uint64_t frames = std::max(frame - window_start_frame_, uint64_t(1));
+  double f = 1.0 / double(frames);
+  std::string s = fmt::format("GPU_PROF frames={} gpu_ms/frame={:.3f} |", frames,
+                              w.total_ns * f * 1e-6);
+  for (uint32_t i = 0; i < kCategoryCount; ++i) {
+    s += fmt::format(" {}={:.3f}ms/{:.1f}", kCategoryNames[i], w.category_ns[i] * f * 1e-6,
+                     double(w.category_count[i]) * f);
+  }
+  s += fmt::format(
+      " | draws={:.0f} img_barriers={:.1f} buf_barriers={:.1f} "
+      "rp_hist(0,1-7,8-63,64+)={:.1f},{:.1f},{:.1f},{:.1f}",
+      double(c.draws) * f, double(c.image_barriers) * f, double(c.buffer_barriers) * f,
+      double(c.pass_draws[0]) * f, double(c.pass_draws[1]) * f, double(c.pass_draws[2]) * f,
+      double(c.pass_draws[3]) * f);
+  s += fmt::format(
+      " | passes={:.1f} split_same_rt={:.1f} reasons(copy=1,barrier=2,dispatch=4,img=8):",
+      double(c.passes) * f, double(c.split_passes) * f);
+  for (uint32_t r = 0; r < 16; ++r) {
+    if (c.split_reasons[r]) {
+      s += fmt::format(" r{}={:.1f}", r, double(c.split_reasons[r]) * f);
+    }
+  }
+  s += fmt::format(" | copybuf={:.1f} ({:.1f} KB) copyimg={:.1f} | dispatch by role:",
+                   double(c.copy_buffer) * f, double(c.copy_buffer_bytes) * f / 1024.0,
+                   double(c.copy_image) * f);
+  for (size_t r = 0; r < size_t(ExternalComputeRole::kCount); ++r) {
+    if (w.role_count[r]) {
+      s += fmt::format(" {}={:.3f}ms/{:.1f}", kRoleNames[r], w.role_ns[r] * f * 1e-6,
+                       double(w.role_count[r]) * f);
+    }
+  }
+  // Render targets by GPU time: label = render pass key (transfers: 1 << 31 |
+  // destination is depth) << 32 | host width << 16 | host height.
+  uint32_t label_order[kMaxPassLabels];
+  for (uint32_t i = 0; i < kMaxPassLabels; ++i) {
+    label_order[i] = i;
+  }
+  std::sort(label_order, label_order + kMaxPassLabels,
+            [&w](uint32_t a, uint32_t b) { return w.label_ns[a] > w.label_ns[b]; });
+  s += " | passes by target:";
+  for (uint32_t i = 0; i < 12 && w.label_ns[label_order[i]] > 0; ++i) {
+    uint32_t label = label_order[i];
+    uint64_t value = pass_labels_[label];
+    s += fmt::format(" {:08X}:{}x{}={:.3f}ms/{:.1f}", uint32_t(value >> 32),
+                     uint32_t(value >> 16) & 0xFFFF, uint32_t(value) & 0xFFFF,
+                     w.label_ns[label] * f * 1e-6, double(w.label_count[label]) * f);
+  }
+  s += fmt::format(" | submissions={} dropped={} skipped={} truncated={}", w.submissions,
+                   w.dropped, w.skipped, c.truncated);
+  REXGPU_INFO("{}", s);
+  ResetWindow();
+  window_start_ns_ = now_ns;
+  window_start_frame_ = frame;
+}
+
+void VulkanGpuProfiler::DestroyPools(const ui::vulkan::VulkanDevice& device) {
+  const ui::vulkan::VulkanDevice::Functions& dfn = device.functions();
+  for (uint32_t i = 0; i < kSlotCount; ++i) {
+    if (pools_[i] != VK_NULL_HANDLE) {
+      dfn.vkDestroyQueryPool(device.device(), pools_[i], nullptr);
+      pools_[i] = VK_NULL_HANDLE;
+    }
+    std::vector<uint32_t>().swap(tags_[i]);
+    slot_submission_[i] = 0;
+  }
+  std::vector<uint64_t>().swap(results_);
+  pending_slot_ = kNoSlot;
+  initialized_ = false;
+}
+
+void VulkanGpuProfiler::Shutdown(const ui::vulkan::VulkanDevice& device) {
+  DestroyPools(device);
+  failed_ = false;
+  window_open_ = false;
+}
