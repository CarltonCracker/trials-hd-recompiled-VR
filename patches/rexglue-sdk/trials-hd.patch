+namespace {
+
+// Host allocations (base_address == nullptr): nothing in the SDK makes them
+// today, but keep the contract (zeroed, page-aligned, released whole).
+std::mutex host_allocations_mutex_;
+std::map<uintptr_t, size_t> host_allocations_;
+
+bool FindHostAllocation(const void* p, size_t length, uintptr_t* base_out, size_t* length_out) {
+  uintptr_t address = reinterpret_cast<uintptr_t>(p);
+  std::lock_guard<std::mutex> lock(host_allocations_mutex_);
+  auto it = host_allocations_.upper_bound(address);
+  if (it == host_allocations_.begin()) {
+    return false;
+  }
+  --it;
+  if (address - it->first > it->second || length > it->second - (address - it->first)) {
+    return false;
+  }
+  if (base_out) {
+    *base_out = it->first;
+  }
+  if (length_out) {
+    *length_out = it->second;
+  }
+  return true;
+}
+
+}  // namespace
+
+size_t page_size() {
+  return 4096;
+}
+
+size_t allocation_granularity() {
+  return 4096;
+}
+
+bool IsWritableExecutableMemorySupported() {
+  // Nothing is executable in linear memory.
+  return false;
+}
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type,
+                 PageAccess access) {
+  (void)allocation_type;
+  (void)access;
+  if (!base_address) {
+    size_t rounded = rex::round_up(length, page_size());
+    void* result = std::aligned_alloc(page_size(), rounded);
+    if (!result) {
+      return nullptr;
+    }
+    std::memset(result, 0, rounded);
+    std::lock_guard<std::mutex> lock(host_allocations_mutex_);
+    host_allocations_[reinterpret_cast<uintptr_t>(result)] = rounded;
+    return result;
+  }
+  // The guest window is always readable and writable; the heaps' page tables
+  // hold reservation, commit and protection state.
+  if (web::IsInGuestWindow(base_address, length) ||
+      FindHostAllocation(base_address, length, nullptr, nullptr)) {
+    return base_address;
+  }
+  return nullptr;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  if (web::IsInGuestWindow(base_address, length)) {
+    // As natively, where the views are a shared file mapping, a decommit or
+    // release keeps the contents.
+    return true;
+  }
+  uintptr_t allocation_base;
+  size_t allocation_length;
+  if (!FindHostAllocation(base_address, length, &allocation_base, &allocation_length)) {
+    return false;
+  }
+  switch (deallocation_type) {
+    case DeallocationType::kDecommit:
+      // Anonymous memory reads back as zero once decommitted.
+      std::memset(base_address, 0, length);
+      return true;
+    case DeallocationType::kRelease: {
+      if (allocation_base != reinterpret_cast<uintptr_t>(base_address)) {
+        return false;
+      }
+      {
+        std::lock_guard<std::mutex> lock(host_allocations_mutex_);
+        host_allocations_.erase(allocation_base);
+      }
+      std::free(base_address);
+      return true;
+    }
+    default:
+      assert_always();
+      return false;
+  }
+}
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  (void)access;
+  if (out_old_access) {
+    *out_old_access = PageAccess::kReadWrite;
+  }
+  return web::IsInGuestWindow(base_address, length) ||
+         FindHostAllocation(base_address, length, nullptr, nullptr);
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  access_out = PageAccess::kNoAccess;
+  length = 0;
+  uintptr_t address = reinterpret_cast<uintptr_t>(base_address);
+  if (web::IsInGuestWindow(base_address, 1)) {
+    length = reinterpret_cast<uintptr_t>(web::window_) + web::kWindowSize + web::kWindowTail -
+             address;
+    access_out = PageAccess::kReadWrite;
+    return true;
+  }
+  uintptr_t allocation_base;
+  size_t allocation_length;
+  if (FindHostAllocation(base_address, 1, &allocation_base, &allocation_length)) {
+    length = allocation_base + allocation_length - address;
+    access_out = PageAccess::kReadWrite;
+    return true;
+  }
+  return false;
+}
+
+// No shared file mappings in a browser: Memory uses the guest window instead.
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length,
+                                          PageAccess access, bool commit) {
+  (void)path;
+  (void)length;
+  (void)access;
+  (void)commit;
+  return kFileMappingHandleInvalid;
+}
+
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+  (void)handle;
+  (void)path;
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  (void)handle;
+  (void)base_address;
+  (void)length;
+  (void)access;
+  (void)file_offset;
