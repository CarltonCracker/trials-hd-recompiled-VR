+namespace {
+struct GpuProf {
+  enum Cat : uint32_t {
+    kRpBig,      // render pass with >= 8 draws (guest scene passes)
+    kRpSmall,    // render pass with 1..7 draws (transfers, post-process quads)
+    kRpClear,    // render pass with no draws (ClearAttachments only / empty)
+    kDispatch,
+    kBarrier,
+    kCopy,       // buffer->image, buffer->buffer, clear image
+    kOther,
+    kCatCount
+  };
+  static constexpr const char* kCatNames[kCatCount] = {"rp_big", "rp_small", "rp_clear", "dispatch",
+                                                       "barrier", "copy", "other"};
+  static constexpr uint32_t kRing = 16;
+  static constexpr uint32_t kMaxQueries = 16384;
+  bool init_tried = false, enabled = false;
+  double ns_per_tick = 1.0;
+  PFN_vkCmdWriteTimestamp write_ts = nullptr;
+  PFN_vkGetQueryPoolResults get_results = nullptr;
+  VkQueryPool pools[kRing] = {};
+  // Per slot: categories (and compute pipeline index for dispatches) of each interval.
+  std::vector<uint32_t> slot_cats[kRing];
+  uint32_t slot_query_count[kRing] = {};
+  bool slot_pending[kRing] = {};
+  uint32_t ring_index = 0;
+  uint32_t cur_slot = 0;
+  // Recording state.
+  std::vector<uint32_t>* cats = nullptr;
+  VkQueryPool pool = VK_NULL_HANDLE;
+  uint32_t query = 0;
+  uint32_t rp_segment = UINT32_MAX;  // index in cats of the open render pass
+  uint32_t rp_draws = 0;
+  uint32_t compute_pipeline_id = 0;
+  // Compute pipelines seen (index -> handle).
+  std::vector<VkPipeline> compute_pipelines;
+  // Accumulators.
+  double cat_ns[kCatCount] = {};
+  uint64_t cat_n[kCatCount] = {};
+  std::vector<double> pipe_ns;
+  std::vector<uint64_t> pipe_n;
+  uint64_t draws = 0, image_barriers = 0, buffer_barriers = 0, layout_changes = 0;
+  uint64_t prev_rp_key = 0, between_mask = 0;
+  uint64_t split_passes = 0, split_reason[16] = {}, copy_buf_n = 0, copy_buf_bytes = 0,
+           copy_img_n = 0, passes = 0;
+  uint64_t rp_draw_hist[4] = {};  // 0, 1-7, 8-63, 64+
+  double total_ns = 0;
+  std::chrono::steady_clock::time_point window = std::chrono::steady_clock::now();
+  uint32_t swaps_at_window = 0;
+
+  void Init(const ui::vulkan::VulkanDevice* device) {
+    init_tried = true;
+    const char* env = std::getenv("TRIALS_GPU_PROF");
+    if (!env || env[0] != '1') return;
+    void* lib = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_NOLOAD);
+    if (!lib) lib = dlopen("libvulkan.so.1", RTLD_NOW);
+    if (!lib) return;
+    write_ts = reinterpret_cast<PFN_vkCmdWriteTimestamp>(dlsym(lib, "vkCmdWriteTimestamp"));
+    get_results = reinterpret_cast<PFN_vkGetQueryPoolResults>(dlsym(lib, "vkGetQueryPoolResults"));
+    auto get_props = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(
+        dlsym(lib, "vkGetPhysicalDeviceProperties"));
+    if (!write_ts || !get_results || !get_props) return;
+    VkPhysicalDeviceProperties props;
+    get_props(device->physical_device(), &props);
+    ns_per_tick = props.limits.timestampPeriod;
+    const auto& dfn = device->functions();
+    VkQueryPoolCreateInfo ci = {};
+    ci.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    ci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    ci.queryCount = kMaxQueries;
+    for (uint32_t i = 0; i < kRing; ++i) {
+      if (dfn.vkCreateQueryPool(device->device(), &ci, nullptr, &pools[i]) != VK_SUCCESS) return;
+    }
+    enabled = true;
+    REXGPU_INFO("GPU_PROF: enabled, {} ns per tick", ns_per_tick);
+  }
+
+  void Harvest(const ui::vulkan::VulkanDevice* device, uint32_t slot) {
+    if (!slot_pending[slot]) return;
+    slot_pending[slot] = false;
+    uint32_t n = slot_query_count[slot];
+    if (n < 2) return;
+    static std::vector<uint64_t> ts;
+    ts.resize(n);
+    if (get_results(device->device(), pools[slot], 0, n, n * sizeof(uint64_t), ts.data(),
+                    sizeof(uint64_t), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) !=
+        VK_SUCCESS) {
+      return;
+    }
+    const std::vector<uint32_t>& c = slot_cats[slot];
+    for (uint32_t i = 0; i + 1 < n && i < c.size(); ++i) {
+      double ns = double(ts[i + 1] - ts[i]) * ns_per_tick;
+      if (ts[i + 1] < ts[i]) ns = 0;
+      uint32_t cat = c[i] & 0xFF;
+      cat_ns[cat] += ns;
+      cat_n[cat]++;
+      total_ns += ns;
+      if (cat == kDispatch) {
+        uint32_t p = c[i] >> 8;
+        if (p >= pipe_ns.size()) {
+          pipe_ns.resize(p + 1);
+          pipe_n.resize(p + 1);
+        }
+        pipe_ns[p] += ns;
+        pipe_n[p]++;
