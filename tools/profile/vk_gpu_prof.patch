+  void Begin(const ui::vulkan::VulkanDevice* device, VkCommandBuffer cb) {
+    if (!init_tried) Init(device);
+    if (!enabled) return;
+    uint32_t slot = ring_index++ % kRing;
+    cur_slot = slot;
+    Harvest(device, slot);
+    pool = pools[slot];
+    cats = &slot_cats[slot];
+    cats->clear();
+    query = 0;
+    rp_segment = UINT32_MAX;
+    device->functions().vkCmdResetQueryPool(cb, pool, 0, kMaxQueries);
+    slot_pending[slot] = true;
+    Stamp(cb, kOther);
+    MaybeReport();
+  }
+
+  void Stamp(VkCommandBuffer cb, uint32_t cat) {
+    if (query >= kMaxQueries - 1) return;
+    write_ts(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, pool, query++);
+    cats->push_back(cat);
+  }
