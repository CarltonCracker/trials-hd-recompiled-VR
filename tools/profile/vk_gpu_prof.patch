+          rp_draw_hist[rp_draws == 0 ? 0 : rp_draws < 8 ? 1 : rp_draws < 64 ? 2 : 3]++;
+        }
+        rp_segment = UINT32_MAX;
+        break;
+      case 3:
+        ++rp_draws;
+        ++draws;
+        break;
+      case 4: {
+        uint32_t id = 0;
+        for (; id < compute_pipelines.size(); ++id) {
+          if (compute_pipelines[id] == compute_pipeline) break;
+        }
+        if (id == compute_pipelines.size()) compute_pipelines.push_back(compute_pipeline);
+        compute_pipeline_id = id;
+      } break;
+      case 5:
+        between_mask |= 4;
+        Stamp(cb, kDispatch | (compute_pipeline_id << 8));
+        break;
+      case 6:
+        image_barriers += ib;
+        buffer_barriers += bb;
+        between_mask |= 2;
+        Stamp(cb, kBarrier);
+        break;
+      case 7:
+        between_mask |= is_img ? 8 : 1;
+        if (is_img) {
+          ++copy_img_n;
+        } else {
+          ++copy_buf_n;
+          copy_buf_bytes += copy_bytes;
+        }
+        Stamp(cb, kCopy);
+        break;
+      default:
+        break;
+    }
+  }
+
+  void End(VkCommandBuffer cb) {
+    if (!enabled) return;
+    Stamp(cb, kOther);
+    slot_query_count[cur_slot] = query;
+  }
+
+  void MaybeReport() {
+    auto now = std::chrono::steady_clock::now();
+    if (now - window < std::chrono::seconds(2)) return;
+    uint32_t swaps_now = g_gpu_prof_swaps.load();
+    uint32_t frames = swaps_now - swaps_at_window;
+    if (!frames) frames = 1;
+    double f = 1.0 / frames;
+    std::string s = fmt::format("GPU_PROF frames={} gpu_ms/frame={:.3f} |", frames,
+                                total_ns * f * 1e-6);
+    for (uint32_t i = 0; i < kCatCount; ++i) {
+      s += fmt::format(" {}={:.3f}ms/{:.1f}", kCatNames[i], cat_ns[i] * f * 1e-6, cat_n[i] * f);
+    }
+    s += fmt::format(" | draws={:.0f} img_barriers={:.1f} buf_barriers={:.1f} rp_hist(0,1-7,8-63,64+)="
+                     "{:.1f},{:.1f},{:.1f},{:.1f}",
+                     draws * f, image_barriers * f, buffer_barriers * f, rp_draw_hist[0] * f,
+                     rp_draw_hist[1] * f, rp_draw_hist[2] * f, rp_draw_hist[3] * f);
+    s += fmt::format(" | passes={:.1f} split_same_rt={:.1f} reasons(copy=1,barrier=2,dispatch=4,img=8):",
+                     passes * f, split_passes * f);
+    for (int r = 0; r < 16; ++r) {
+      if (split_reason[r]) s += fmt::format(" r{}={:.1f}", r, split_reason[r] * f);
+    }
+    s += fmt::format(" | copybuf={:.1f} ({:.1f} KB) copyimg={:.1f} | dispatch by pipeline:",
+                     copy_buf_n * f, copy_buf_bytes * f / 1024.0, copy_img_n * f);
+    for (size_t p = 0; p < pipe_ns.size(); ++p) {
+      if (pipe_n[p]) {
+        s += fmt::format(" p{}={:.3f}ms/{:.1f}", p, pipe_ns[p] * f * 1e-6, pipe_n[p] * f);
+      }
+    }
+    REXGPU_INFO("{}", s);
+    for (auto& v : cat_ns) v = 0;
+    for (auto& v : cat_n) v = 0;
+    std::fill(pipe_ns.begin(), pipe_ns.end(), 0.0);
+    std::fill(pipe_n.begin(), pipe_n.end(), 0);
+    draws = image_barriers = buffer_barriers = 0;
+    split_passes = copy_buf_n = copy_buf_bytes = copy_img_n = passes = 0;
+    for (auto& v : split_reason) v = 0;
+    for (auto& v : rp_draw_hist) v = 0;
+    total_ns = 0;
+    window = now;
+    swaps_at_window = swaps_now;
+  }
+};
+GpuProf g_gpu_prof;
+}  // namespace
 
