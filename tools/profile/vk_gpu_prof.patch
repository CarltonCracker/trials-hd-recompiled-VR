+  // 6 barrier, 7 copy/clear image.
+  void Command(VkCommandBuffer cb, int kind, VkPipeline compute_pipeline, uint32_t ib,
+               uint32_t bb, uint64_t rp_key = 0, uint64_t copy_bytes = 0, bool is_img = false) {
+    switch (kind) {
+      case 1:
